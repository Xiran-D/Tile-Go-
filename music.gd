# ===== 运行期可调参数 =====
@export_group("节拍")
@export_range(30.0, 200.0, 1.0) var bpm: float = 72.0          # 每分钟拍数
@export_range(1, 8, 1) var beats_per_bar: int = 4              # 每小节拍数
@export_range(1, 4, 1) var subdiv: int = 2                     # 每拍细分数（最小步长 = 60/bpm/subdiv）
@export_range(0.0, 1.0, 0.01) var density_calm: float = 0.22   # 平静时的音符密度（每步发声音的概率）
@export_range(0.0, 1.0, 0.01) var density_tense: float = 0.68  # 张力拉满时的密度

@export_group("和声")
@export_range(33, 81, 1) var root_midi: int = 50               # 主音（MIDI；50 = D3）
@export_range(1, 3, 1) var oct_span: int = 2                   # 旋律可上探的八度数（平静时只用低的那一档）
@export_range(0, 40, 1) var tension_percent: int = -1          # ≥0 时**强制**张力（调试/截图用）；-1 = 随战况
@export_range(0.0, 1.0, 0.01) var w_captures: float = 0.80     # 提子差 → 张力 的权重
@export_range(0.0, 1.0, 0.01) var w_density: float = 0.50      # 盘面密度 → 张力 的权重
@export_range(0.0, 1.0, 0.01) var w_calm: float = 0.60         # 停手/终局 → 收束 的权重
@export_range(1.0, 40.0, 0.5) var capture_ref: float = 8.0     # 提子差几子算"拉满"

@export_group("局势四轴（响度 / 节奏 / 音高 / 和弦色彩）")
## ★★★ 2026-10-07 四轴改造。用户口径：**从不同方面**读取局势，分别决定
## 响度 / 节奏 / 音高 / 和弦色彩。改造前的状态是"所有东西都由一个 `tension` 标量驱动"
## （而且那个标量还读不到局势层：见 `SITUATION_FIELDS` 的注释）。
##
## 每个轴只在**一个**地方被读（`axes_from_state()`），落点如下 ——
##   响度 → 所有事件的 `gain` 乘一个倍率   |   节奏 → 旋律网格 `stride` + 音符密度
##   音高 → 旋律的**度数**偏移（不动 `root_midi`）|   色彩 → `_harmony_for_bar()` 的 `hue`
##
## ⚠️ 量纲纪律（铁律 14）：`pitch` 的输入端必须是**无界**量（`an_player_diff` = 目数差），
##    不能拿胜率（有界 ⇒ 单调性判不了）。"几目算拉满"的尺子在**消费端**（本组 `point_ref`）。

## ① 响度 ← 危险度 `an_crisis`（0 = 安全 ~ 1 = 一方快崩）。
## 倍率直接乘在事件 gain 上（不是乘在 `bgm_volume` 上：那样会改到用户在菜单里设的音量）。
## ★ 取值范围有硬约束：最大基准 gain 是 0.60（和弦根音）⇒ `loud_max_scale ≤ 1.55`
##   才会撞上 `_play_event` 的 [0.01,1.0] 夹子（撞上就是**静默限幅**，响度轴在高位失灵）。
## 0.60→1.50 全量程 = **7.9 dB**（−4.4dB ~ +3.5dB，相对不动），足够当"戏剧性"用。
@export_range(0.0, 1.55, 0.01) var loud_min_scale: float = 0.60
@export_range(0.0, 1.55, 0.01) var loud_max_scale: float = 1.50

## ② 节奏 ← 交手烈度 + 进程（提子差 · 盘面密度 − 停手）。两个落点：
##   · `density`（每步发声音的概率）随 `tempo` 从 `density_calm` 拉到 `density_tense`；
##   · 旋律的**网格**：`stride` 从 `rhythm_stride_calm` 拉到 `rhythm_stride_tense`
##     （2 = 旋律每两步才发一次 ⇒ 听感慢一倍；1 = 每步都发）。
## ★★ 用"网格"而不是改 `bpm`：改 `bpm` 会让 `step_seconds()` 在**小节中途**变，
##    `_advance()` 的时钟与新步长不同步 ⇒ 拍到拍之间会**漂移**（而且判据② 会把 `bpm`
##    临时改掉去对账，根本量不到它）。`stride` 只决定"这一步发不发"，格子纹丝不动。
@export_range(1.0, 4.0, 1.0) var rhythm_stride_calm: float = 2.0
@export_range(1.0, 4.0, 1.0) var rhythm_stride_tense: float = 1.0

## ③ 音高 ← 优劣（`an_player_diff`，正 = **玩家**目数领先，无界）。
## `point_ref` = 几目算拉满（"差距感"的尺子）；`pitch_span_deg` = 拉满时旋律偏多少个
## **音阶度数**。★ 5 度正好 = 1 个八度（五声宫调的 `scale` 是 5 个音一循环）⇒
## 全量程 = ±1 八度，且**始终落在当前曲风的音阶上**（偏的是度数，不是半音）。
@export_range(1.0, 100.0, 1.0) var point_ref: float = 20.0
@export_range(0, 5, 1) var pitch_span_deg: int = 5

## ④ 和弦色彩 ← 形态度 = 双方 已活 / 可做活 / 已死 三类**块数**的比例。
##   · 全部已活（定形、胜负已明）⇒ 0.00 ⇒ 走**第一档进行**（主—属），无偏音；
##   · 有"可做活"的块（死活未定）⇒ 偏 `HUE_MID` ⇒ 走**第二档进行**；
##   · 已有死块（真的碎在盘上）⇒ 推向 1.00 ⇒ 走**第三档进行** + 偏音。
## ★ 具体的三档进行现在属**曲风本体**（`STYLES[..]["progs"]`）—— 这里不再点名常量。
## 两个权重是"哪一类更紧张"的旋钮：死块恒定给满，未定形只给一部分
## （`0.55` 意味着"全盘未定形"落在中档，要真的出现死块才会到最高档）。
@export_range(0.0, 1.0, 0.01) var form_unsettled_weight: float = 0.55
@export_range(0.0, 1.0, 0.01) var form_dead_weight: float = 1.0

@export_group("曲风与特殊时刻（乐句 / 古筝技法）")
## 当前曲风（`STYLE_IDS` 里的 id）。★ 非法值**不报错**：`_style()` 回退到表里的第一项。
## 为什么"退回"比"报错"好：退回是**听得出来的行为变化**（换了音阶与乐句），
## 而不是静默失声 —— 而且判据 ㉜ 会把回退路径本身钉住（合法 id 全解析 + 非法 id 必须退回）。
@export var style_id: String = "guzheng"

## 特殊时刻乐句的总开关。关掉 ⇒ 退回"只有情绪连续变化"的旧音乐（一个可听出来的行为变化）。
@export var cue_enabled: bool = true
## 乐句的整体音量倍率。★ 它与"响度轴"的 `gain_scale` 是**相乘**关系：两个轴各管各的
## （危险度决定"多大声"，这一项决定"乐句相对背景多突出"）。
@export_range(0.0, 1.5, 0.01) var cue_gain: float = 0.80
## 两次乐句之间至少隔几个小节。
## ★ 必须有冷却：`an_live_blocks` / `an_dead_blocks` 这类字段在相邻几步里会**反复抖动**
## （AI 侧每步都可能重新划块）⇒ 没有冷却会变成"每步都在放乐句"，那是噪音不是音乐。
@export_range(0, 8, 1) var cue_cooldown_bars: int = 2
## 「危急」时刻的闸值：`an_crisis` 从**下方**越过它才算一次（不是"在闸上方"—— 那会每步都触发）。
@export_range(0.0, 1.0, 0.01) var cue_crisis_gate: float = 0.70
## 一次提子几子以上算「大提子」（换一句更长的乐句）。
@export_range(1, 20, 1) var cue_big_capture: int = 3

## 和弦的**音数**（平静 → 张力满，按色彩插值，夹在 `CHORD_TONES_MIN..MAX`）。
## ★★ 这是"减少同时弹奏的和弦"最直接的那个旋钮：改造前是**固定 3~4 个音并且顶音加倍八度**
##   ⇒ 小节头一响就是四五个音叠在一起。现在默认 2→3，并且取消了八度加倍。
@export_range(2, 4, 1) var chord_tones_calm: int = 2
@export_range(2, 4, 1) var chord_tones_tense: int = 3

## 和弦音的**音间距**（单位 = **最小步长** `step_seconds()`）。**0 = 齐奏**（所有音同时起）。
## ★★★ 2026-10-17 默认改回 **0.0（齐奏）**。用户口令（逐字）：
##     「琶音太吵了，还是换回齐奏吧，好好调整和弦，让它更和谐就好。另外所有音都适当延长一点」
##   这条**覆盖**了上一轮「琶音太快了，削弱了节奏」那次改动 —— 先把它放慢到"步"、
##   用户听过之后仍判定**琶音本身**就是那个吵的东西（一串依次拨出的音会自成一条
##   "滋滋"的旋律线，抢走注意力），所以改成**齐奏**：让一整个和弦像"一下"、
##   像一个 pad，而不是"一串"。
##   ⇒ "吵"这件事不再靠**错开时间**解决，改由**和声本身**解决（见 `_harmony_for_bar()`
##     的偏音修正 + `CHORD_BANNED_ICS` + 和弦增益重平衡）。
## ★ 这个旋钮**保留**（不是删掉）：`arp_step > 0` 就能把和弦重新摊成琶音；
##   而 `_arp_gap()` / `_arp_fit_seconds()` 这套"错开占位"的机制也留着 ——
##   齐奏时它退化成 0 占位、余音取满，行为与"没有琶音这回事"逐字相同（新式在旧工况下退化）。
## ★ 单位仍然是**步**而不是秒：秒与节拍无关，而本工程的节拍会随棋钟在 36~200 BPM 间变。
@export_range(0.0, 4.0, 0.5) var arp_step: float = 0.0

## ★★★ 2026-10-17 第二轮口令（逐字）：「怎么还有琶音，都去掉」
##   **错开量总闸**，连乘在**每一个**事件的 `at` 上（和弦 / 四种技法 / 特殊时刻乐句）。
##   `0.0` = 全曲**没有任何两个音是错开起的**；`1.0` = 各出口按各自设计错开。
##
## ★ 为什么在 `arp_step` 已经归零之后还需要这个总闸 —— 因为"琶音"不止一处出口：
##   · 和弦的错开由 `arp_step` 管（已齐奏）；
##   · **四种古筝技法**每步各有 25%~30% 的概率出场，而"摇指 = 同音反复 3~4 次"、
##     "刮奏 = 4~7 个音在 0.45 秒内上行" —— **它们本身就是琶音**，而且随机、频繁
##     ⇒ 这就是"换回齐奏之后**怎么还有**琶音"的真正来源；
##   · **特殊时刻乐句**的 `at` 数组（0.0/0.12/0.24/0.36…）也是滚动。
##   三处各管一处的话，"全曲没有琶音"这件事永远没法用一句话验证 ⇒ 抽出唯一出口 `_stagger()`。
##
## ★ `stagger_scale == 0` 时会连带两件事，**不是随手加的开关，是必然推论**：
##   ① **技法整体不出场**。零错开下的技法会直接破坏本轮刚立的和声不变量：
##      倚音 = "目标音 + 下行邻音"**同时**响 = 小二度（`CHORD_BANNED_ICS` 第 1 项），
##      摇指 = 4 个同音同时 ⇒ 增益 4 倍叠加，刮奏 = 4~7 个音同时 ⇒ 音簇。
##   ② **乐句每个 seg 只发落点音**（最后一个）。同理：跑动型乐句齐奏就是一个音簇，
##      而摇指段 `[3,3,3,3]` 齐奏就是 4 个同音叠加。落点音才是乐句的和声意图。
@export_range(0.0, 1.0, 0.05) var stagger_scale: float = 0.0

## 四种古筝技法的出现概率（0 = 关掉该技法）。★ 细节（间隔 / 音数 / 泛音八度）属**曲风本体**，
## 在 `STYLES[..]["tech"]` 里 —— 这里只给"多常用"。
## ★ 技法挂在**旋律槽**上（改"这一步怎么弹"），不另开一路 —— 另开一路会让技法把
##   音符密度偷偷抬上去，正好是"减少同时弹奏"的反面（判据 ㉝ 的阴性面钉这一点）。
@export_range(0.0, 1.0, 0.01) var tech_tremolo: float = 0.25    # 摇指：同音快速反复
@export_range(0.0, 1.0, 0.01) var tech_gliss: float = 0.25      # 刮奏：从低处快速上行到目标音
@export_range(0.0, 1.0, 0.01) var tech_grace: float = 0.30      # 倚音：目标音前加一个下行邻音
@export_range(0.0, 1.0, 0.01) var tech_harmonic: float = 0.30   # 泛音：旋律之上的高八度亮点

# ===== 棋钟对接（2026-10-16）=====
## 用户口令：「加入棋钟系统，要与音乐对接，让音乐节拍和双方下棋频率相关」。
##
## ★★★ 边界（谁负责什么，三处各一件、不许越界）：
##   · `game_clock.gd`：算出**已平滑**的 `clk_bpm` 与 `clk_pressure`（BPM 的曲线形状属棋钟）；
##   · 本文件（消费端）：**什么时候真的换速**（小节头）+ 换速时把时钟余量按新步长重标定
##     + 压力并进节奏轴 + 压力过闸时每拍补一个读秒声；
##   · `game.gd`：只把快照挂到成员 `clk` 上（本文件反射读，与 `BATTLE_FIELDS` 同款）。
##
## ★★ 为什么"换速时机"必须在本文件里、而且只能在**小节头**：
##   注释里那条老约束（改 `bpm` 会让 `step_seconds()` 在小节中途变、`_advance()` 的时钟
##   与新步长不同步 ⇒ 拍与拍之间漂移）**不是"不能变速"**，而是"不能在半拍上变速"。
##   解法有两条同时做才成立：① 只在小节头提交；② 提交后把 `_clock` 里"距下一步的余量"
##   按新旧步长之比重标定（否则新步长更短时会立刻补跳一步 = 听感上的抢拍）。
##   两条都在 `_advance()`/`_clock_ext_apply()` 里，**改动面只有这两处**。
@export_group("棋钟对接（外部棋钟 → 节拍 / 读秒声）")
@export var clk_follow: bool = true
## 外部目标 BPM 的合法夹取范围（棋钟给什么值都夹进来：宁可夹住，也不要让 `step_seconds()`
## 走到 0 或负数 —— 那会让 `_advance()` 的 while 循环空转）。
@export_range(30.0, 240.0, 1.0) var clk_bpm_min: float = 36.0
@export_range(30.0, 240.0, 1.0) var clk_bpm_max: float = 200.0
## 剩余时间压力 → **节奏轴**的权重（并进 `clash_level()`，与提子差/密度同一处消费）。
## ★ 为什么并进 `clash_level` 而不是另开一路：`clash_level` 是"节奏轴唯一来源"这条
##   结构约定（见 `axes_from_state()` ②）——另开一路会让节奏轴变成两处写，改一处不改另一处。
@export_range(0.0, 1.0, 0.01) var clk_pressure_weight: float = 0.45
## 读秒声：压力超过这个闸才开始出现（0.35 ⇒ 剩余时间低于 `pressure_ref` 的 65% 时）
@export_range(0.0, 1.0, 0.01) var clk_tick_gate: float = 0.35
@export_range(0.0, 1.0, 0.01) var clk_tick_gain: float = 0.26
## 读秒声的音高（88 = E6，清脆、与 D 主音的五声音阶不撞）
@export_range(33, 96, 1) var clk_tick_midi: int = 88
## 读秒声的余音长度与亮度。★ 必须**远短于** `note_seconds`：读秒声是"心跳"，
##   尾巴长了会和旋律糊成一片（听不出"一次一拍"）。
@export_range(0.02, 0.5, 0.01) var tick_seconds: float = 0.11
@export_range(0.0, 1.0, 0.01) var tick_brightness: float = 0.92

@export_group("音色（拨弦合成）")
## 单音余音长度（T60 口径）。★★ 2026-10-16 深夜 **1.6 → 2.4**，用户口令：
##   「我感觉留白太多，尽量把音符延长解决」—— 所以这一口**专门**用来填留白，
##   而**不是**去提高音符密度（那是另一条轴，会同时改变"这一步发不发"这个事实）。
##   · 72 BPM 下一个音跨 `2.4 / 0.4167 = 5.76` 步；
##   · 平静档的旋律只落在**每隔一步**的格子上（`rhythm_stride_calm = 2`）
##     ⇒ 余音必须盖住两个格子以上，否则每个音之间都留一道缝（那就是用户听到的留白）。
##   ★ 上下两个界都不在这条参数自己身上：判据 ㉖ 从"必须 ≥ v8 的 `LENGTHEN_MIN` 倍"
##     钉住"适当延长"这条口令（太短 ⇒ 红），判据 ㊱ 从**最稀疏的那一档**量静默占比与最长静默
##     （留白红），并从张力满档量平均同时发声（太挤红）。
## ★★ 2026-10-17 **2.4 → 2.9**："所有音都适当延长一点"（+21%）。
@export_range(0.2, 6.0, 0.1) var note_seconds: float = 2.9     # 单音余音长度（T60 口径）
## ★★ 2026-10-17 **4.0 → 4.8**（+20%）。它只服务**乐句的延长音**（终局落宫、块死低音），
##   那里正是要"余韵长"的地方；正常和弦不走这一族（走 `arp`）。
@export_range(0.5, 12.0, 0.1) var pad_seconds: float = 4.8     # 长音（乐句的延长音）长度
## ★ 2026-10-16：和弦音**不再**用 `pad_seconds`，改用 `arp` 这一族。
##   理由就是用户报的"有点吵"：`pad_seconds = 4.0` 而一个小节只有 3.33 秒
##   ⇒ 上一个和弦还没停、下一个和弦就压上来，四五个音永远叠着响。
##   区分之后 `pad`（4 秒）留给**乐句的延长音**（终局落宫、块死低音）—— 那里正是要"余韵长"。
##
## 和弦（`arp` 族）余音长度（秒）。★★ 硬约束 **`≤ pad_seconds / 2`**（判据 ㉖ 钉着）：
##   和弦族的平均同时发声 `chord_tones × ring / bar_seconds` 必须 ≤ 初版同量的 1/2
##   = `0.5 × chord_tones × pad / bar` ⇔ **`ring ≤ pad_seconds / 2`**
##   （`chord_tones`、小节时长两边约掉 ⇒ **与速度无关**）。
##   ★ 2026-10-16 那一轮这里是 1/3（用户「保留初版约1/3的同时演奏和弦」）；
##     2026-10-17「换回齐奏」把那条口径取代了，界放宽到 1/2（理由见 `SIM_CHORD_BUDGET`）。
##   默认 1.80 ⇒ `1.80 / 4.8 = 0.375` ≤ 界 0.5（初版是 4.0/4.8 = 0.833）⇒ 有余量。
## ★ 实际用到的值还要再过一道 `_arp_fit_seconds()`（快节奏下自动收窄，保证和弦不跨小节）——
##   这一条**不是**洁癖：`arp_seconds` 是秒，而小节随 BPM 缩；200 BPM 时一小节只有 1.2 秒
##   ⇒ 固定 1.55 秒的余音**必然**跨小节，等于把"糊"在快节奏下原样搬回来（而且是静默的）。
## ★★ 2026-10-17 **1.30 → 1.80**（相对 v8 的 1.5 是 +20%），"所有音都适当延长一点"。
##   齐奏下余音是**唯一**让和弦听起来"像一个和声"而不是"三下拨弦"的东西，
##   所以它比别的音族更需要延长；同时它仍被 `_arp_fit_seconds()` 夹在**一小节之内**。
@export_range(0.2, 6.0, 0.1) var arp_seconds: float = 1.80     # 和弦（`arp` 族）余音长度
## 装饰短音（`orn`）：刮奏 / 摇指 / 倚音 / 泛音**共用**这一族。
## ★ 必须**远短于** `arp_seconds`：刮奏是 7~8 个音在 0.4 秒里跑完，
##   每个音要是都拖 1.55 秒尾巴，那串音就糊成一片噪音（判据 ㉖ 钉这条大小关系）。
## ★★ 2026-10-17 **0.60 → 0.72**（+20%）。它只能跟着小幅延长：这一族一长，刮奏立刻糊。
@export_range(0.05, 2.0, 0.01) var orn_seconds: float = 0.72
@export_range(0.0, 1.0, 0.01) var orn_brightness: float = 0.75
@export_range(0.0, 1.0, 0.01) var brightness: float = 0.62     # 激励亮度（越低越"闷"，越像指甲肉触弦）
## 激励中**随机分量**的比例。
##   · 0.0 = 纯确定性锯齿：谐波完整且幅度按 1/k 平滑滚降 ⇒ **厚、暖**，像真弦；
##   · 1.0 = 纯白噪声：各次谐波是**随机抽签**，会被抽到接近零 ⇒ 谱是"带随机零点的梳"，
##     听感**空、细、像绷紧的琴弦**（实测 A4 第 3 谐波只剩基频的 0.01×，真弦应约 0.33×）。
## ★ 默认 **0.30 = 用户选定的「预设 D」**（2026-10-06：「先套用你之前的预设D」）。
##   等响四档 A1.00/B0.60/C0.40/D0.30 里唯一同时满足"够厚"与判断 ⑤（亮/暗档对比度
##   ≥1.15 倍，即 `brightness` 还活着）的那一档：实测 ⑤比值 D=1.66（C=2.59 · B=7.49 ·
##   A=7.56），而 0.20 只有 1.25、0.10 只剩 1.10 ⇒ **0.30 是可交付下界**。
##   历史：首版写死 1.0（纯噪声，最"细"）就是为了"与首版逐位相同"。
@export_range(0.0, 1.0, 0.01) var excit_noise: float = 0.30
@export_range(8000, 48000, 100) var sample_rate: int = 22050   # 合成采样率（也决定离线渲染的 wav 采样率）
@export_range(1, 32, 1) var polyphony: int = 16                # 同时可发声的音符数（池大小）
## 环路内直流阻塞器的拐点频率（Hz）。★ 必须有它：延迟线是**环形**的，"整根弦一起平移"
## 也是它的一个模态（k=0），而那个模态的增益最高 ⇒ 不掐掉它，直流最终会盖过基频
## （实测 880Hz 音的尾段 99.98% 是直流，听感是"闷响"而不是有音高的拨弦音）。
## 取值远低于最低音（146.8Hz）即可，取 6Hz ⇒ 对最低音只衰减约 0.08%。
@export_range(0.5, 50.0, 0.5) var dc_block_hz: float = 6.0

## ★★★ 环路修复开关（2026-10-06）。★ **两个都开 = 出货默认**（用户口令「把这两个缺陷修了」
##   + 「确保音符时长准确」⇒ 缺陷必须在**默认路径**上消失，不能只是一个"可选开关"）。
##   两个都关 = **与旧引擎逐位相同**（旧路径逐字保留）⇒ 一条命令即可回退，且回退结果可验。
## 为什么保留开关、而不把旧路径删掉：
##   · 本次改动会动**已定版的音色**（高音尾巴变长、整体音高下移）⇒ 必须留一键回退的路。
##     回退方式（两种任选）：① 把下面两行默认改成 `false`；② 运行时 `--musicloopfix=0`。
##   · "两开关全关 ⇒ 逐字节等于旧件"是一条**可验的外部锚**：工作区归档件
##     `音乐验收/music_v2_preview.wav`（md5 ea00af37…）与 `music_v2_preview_note.wav`
##     （md5 92c948ee…）是旧引擎产物，在当前代码下 `--musicloopfix=0 --musicexcit=1.0`
##     必须**逐字节重现**它们。这条同时把"新路径没被误触"钉住。
##   · `loop_pitch_fix`：修**缺陷 C** —— 全部音偏高 4.8~52.1 音分（越高越偏）。
##     根因：环路的真实周期是 `nn - 0.5 - nn·atan(dc/f)/2π`，而代码里 `trip = nn + 0.5`
##     **符号写反**；且整数延迟线凑不出小数周期。修法 = 环长改 `_ring_len()` +
##     一阶**全通**（|A|≡1 ⇒ 不添幅度损耗）补上分数延迟，使 τ = sr/f 精确成立。
##   · `loop_loss_fix`：修**缺陷 D** —— `note_seconds`/`pad_seconds` 在高音上兑不了
##     （110Hz 99% → 440Hz 66% → 1397Hz 13%）。根因：每趟总损耗 = `damp × |H(θ₁)|`，
##     而 `|H(θ₁)|` 是滤波器白拿的，被 `sr/nn`（高音每秒钟跑 1378 趟）放大。
##     ★ 不能用"把损耗补偿进 damp"（`loop_comp` 的老路）：补偿后 damp 在高音 >1
##     ⇒ **直流模态成长**（实测 RMS 尾段 +12.8dB、直流涨 28 倍）。
##     修法 = 两抽头平均换成**对称三抽头** `(g0, 1-2g0, g0)`：对称 ⇒ 群延迟恒为 1、
##     与 g0 无关（**不扰动音高**，与 `loop_pitch_fix` 完全解耦）；且 `|H| ≈ 1-g0·θ²`
##     与两抽头的 `1-θ²/8` **同族** ⇒ 谐波衰减的**形状**不变，只是缩到预算允许的量级。
## ★ 两者各管一个轴、必须同时开才是出货态：只开 `loop_pitch_fix` 音高对但时长仍塌
##   （13%）；只开 `loop_loss_fix` 时长对但音高仍偏。自检 ⑰ 同时验**两种滤波器形状**，
##   任何一档被静默钳位都会红。
## 设计、反解与 26 音实测见工作区 `音效生成器/_proto_loop_fix.js` +
## `音乐验收/新环路原型_验证.txt`（音高 ≤0.37 音分 · 兑现 94~102% · 无发散）。
@export var loop_pitch_fix: bool = true
@export var loop_loss_fix: bool = true
## 三抽头的 g0 上限（音色旋钮）。g0 越大 = 高次谐波衰减越快（越"拨弦"），
## 但每个音自己的预算是 `|H(θ₁)| ≥ dampTarget`（保证 damp ≤ 1）⇒ 高音上被迫压平。
## 0.125 = 把 `1-2g0(1-cosθ)` 的 θ² 系数配到与旧引擎 `cos(θ/2)` 同级。
@export_range(0.0, 0.25, 0.005) var loop_damp_max: float = 0.125

@export_group("音量与开关（与菜单设置页同一份）")
@export_range(0.0, 1.0, 0.01) var bgm_volume: float = 0.30     # 音乐音量（旧名不变：菜单滑条直连它）
@export_range(0.0, 1.0, 0.01) var sfx_volume: float = 0.45     # 音效音量（落子声）
@export var autoplay_bgm: bool = true                          # 启动即起节拍器（菜单→对局无缝延续）
@export var muted: bool = false                                # 静音开关
@export var accent_on_move: bool = true                        # 落子后**下一拍**给一个重音（仍在格子上，不抢拍）

# ===== 内部状态 =====
var _pool: Array[AudioStreamPlayer] = []
var _pool_i: int = 0
var _sfx_player: AudioStreamPlayer = null
var _sfx_place: AudioStream = null
var _running: bool = false
var _clock: float = 0.0                # 距离"下一步"还差多少秒（累积到 _step_dur 就推进一步）
var _step_idx: int = 0                 # 单调步号（唯一的时间坐标）
var _last_move_seen: int = -1          # 上一次看到的 `_last_move`（用来识别"刚落子"）
var _accent: bool = false              # 下一拍是否重音
var _wav_cache: Dictionary = {}        # "midi|kind|指纹" -> AudioStreamWAV
var _cache_fp: String = ""             # 生成缓存时用的音色指纹（参数一改就整体作废）
var _no_audio_warned: bool = false     # headless 提示只打一次
var _battle_warned: bool = false       # "读不到战况"提示只打一次
## 特殊时刻（cue）用的**上一步**战况快照。`_detect_cue()` 是纯函数，内存放在这里。
## ★ 初值必须是空字典：空 ⇒ `_detect_cue()` 直接返回 ""，于是"刚开局那一步"不会
##   因为"从 0 变成 3 个提子"而误放一句乐句（那不是事件，那是第一次读数）。
var _st_prev: Dictionary = {}
## 乐句冷却：下一个**允许**放乐句的步号。步号是单调的（`_step_idx`），所以比秒数稳。
var _cue_until_step: int = 0
var _cue_warned: bool = false          # 乐句库缺项只提示一次
var _style_warned: bool = false        # 未知曲风 id 只提示一次
## 曲风表覆盖（**只给自检用**）。空 = 用 `STYLES` 常量表。
## ★★ 存在的**唯一**理由与 `--musiccontract=` 同款（见 `DEFAULT_CONTRACT_PATH` 的注释）：
##   让判据 ㉜ 能在**不改 `STYLES` 真源**的前提下证明"换 id 真的会换声" ——
##   现在表里只有一套曲风，"两套曲风声音不同"这条断言的分母是 0，
##   没有这个口子它就成了一条**恒真式**（恒真的判据比没有判据更坏：它假装验过了）。
var _style_table_override: Dictionary = {}
## 棋钟接管时的**实际生效** BPM。0 = 没被接管（此时 `effective_bpm()` 逐位返回 `bpm`）。
## ★ 分成两个变量（`bpm` = 用户/Inspector 定的基准，`_bpm_now` = 棋钟推来的）而不是
##   直接写 `bpm`：① 棋钟一旦失效（比如没人喂），基准还在，音乐不会卡在一个奇怪的数上；
##   ② `--musictest` 判据② 是拿 `bpm` 做解析式对账的 —— 直接改 `bpm` 会让那条判据
##   在"棋钟接管过"之后**读到被改过的期望值**（判据与数据同源 = 恒真）。
var _bpm_now: float = 0.0

## 长卡顿后一次最多补几步。为什么必须限幅：进程被挂起/大卡顿后 `delta` 可能是几秒
## ⇒ 一次补几百步会变成**噪音轰炸**。宁可丢几步，也不要"炸一下"。
const _MAX_CATCHUP := 4


func _ready() -> void:
	for i in polyphony:
		var p := AudioStreamPlayer.new()
		p.name = "Note%d" % i
		add_child(p)
		_pool.append(p)
	_sfx_player = AudioStreamPlayer.new()
	_sfx_player.name = "SFXPlayer"
	add_child(_sfx_player)
	if ResourceLoader.exists(SFX_PATH):
		_sfx_place = load(SFX_PATH)
	_apply_volumes()
	_apply_cli_overrides()
	# ★ 自动化运行（任何 `--xxxxtest` / 截图档）**绝不起节拍器**：
	#   否则自检期间 `_process` 会一直在调度音符，判据会量到一个"自己动着的"系统。
	#   `GameConfig.is_automated_run()` 是这件事的唯一真源（本工程铁律 8）。
	if autoplay_bgm and not GameConfig.is_automated_run():
		play_bgm()


## 调试用：命令行覆盖音色参数。**只在显式给出时才动**，默认一个都不改。
##   `--musicexcit=<0..1>`：激励里随机分量的比例（0 = 纯锯齿/厚暖，1 = 纯噪声/薄细）
##   `--musicloopfix=<0|1>`：环路修复开关（**同时**置两个；1 = 修音高 C + 修时长 D）
##   `--musicpitchfix=<0|1>` / `--musiclossfix=<0|1>`：**只**置其中一个。
##     ★ 为什么不能只有合并开关：A/B 听感必须"**一次只动一个轴**"（本工程铁律 47）。
##       合并成一个开关听，耳朵分不清"音变准了"与"音变长了"各占多少 ——
##       要的是四件：旧 / 只修音高 / 只修时长 / 都修。
## ★ 为什么需要这个口子：音色的最终判据是**用户的耳朵**，而耳朵只能在
##   "同一段音乐、只差一个参数"的条件下比较 ⇒ 必须能不编辑文件就换参数。
##   `--musicloopfix` 尤其要：它要产出 A/B 两件（旧环路 vs 新环路）给耳朵裁决，
##   而"两开关全关 ⇒ 逐字节等于旧件"这条判据也靠它。
func _apply_cli_overrides() -> void:
	var s := _arg_value("--musicexcit=")
	if s != "":
		excit_noise = clampf(s.to_float(), 0.0, 1.0)
		print("[Music] excit_noise = %.2f（命令行覆盖）" % excit_noise)
	# ★ 顺序要紧：先读两个**单轴**开关，再读**合并**开关（合并开关以覆盖为准）。
	#   反过来会让"只修音高"被 `--musicloopfix` 的缺省行为吃掉 —— 那是静默的。
	var pf := _arg_value("--musicpitchfix=")
	if pf != "":
		loop_pitch_fix = pf.to_int() != 0
	var lf := _arg_value("--musiclossfix=")
	if lf != "":
		loop_loss_fix = lf.to_int() != 0
	var both := _arg_value("--musicloopfix=")
	if both != "":
		loop_pitch_fix = both.to_int() != 0
		loop_loss_fix = loop_pitch_fix
	if both != "" or pf != "" or lf != "":
		print("[Music] 环路修复开关：pitch_fix=%s loss_fix=%s（命令行覆盖）" % [
			str(loop_pitch_fix), str(loop_loss_fix)])


func _process(delta: float) -> void:
	if _running:
		_advance(delta)


# ===== 时间推进（**唯一**入口：在线与离线渲染都走它） =====
## 推进一步所需秒数 = 60 / bpm / subdiv。★ 判据 ② 就是拿这条解析式对账的。
## ★★ 2026-10-16：分子上的 BPM 改成 `effective_bpm()` —— 但**没被棋钟接管时它逐位等于
##   `bpm`**（`_bpm_now <= 0`），所以判据② 的解析式对账一字不变、结论一字不变。
func step_seconds() -> float:
	return 60.0 / maxf(effective_bpm(), 1.0) / float(maxi(subdiv, 1))


## 实际生效的 BPM：被棋钟接管时用它推来的值，否则用基准 `bpm`。
## ★ 这是"音频侧唯一读 BPM 的地方"——`step_seconds()` 与外部读数都走它（一处写一处读）。
func effective_bpm() -> float:
	if not clk_follow or _bpm_now <= 0.0:
		return bpm
	return _bpm_now


## 推进 `delta` 秒，跨过多少步就调度多少步（长卡顿最多补 `_MAX_CATCHUP` 步）。
## ★★ 2026-10-16（棋钟对接）：每一步之后要**复查步长** —— 因为 `_on_step()` 可能正好
##   落在小节头上、并把棋钟推来的新 BPM 提交了。换了步长就必须把 `_clock` 里
##   "距下一步的余量"按 `新/旧` 之比重标定：`_clock` 是**时间量**，换了尺度不换算的话，
##   新步长更短时余量会"立刻够一步"⇒ 当场补跳一拍（听感=抢拍），
##   而这条路径**不报任何错**（音符照发，只是节奏挪了一下）。
func _advance(delta: float) -> void:
	_clock += maxf(delta, 0.0)
	var sd := step_seconds()
	var guard := 0
	while _clock >= sd and guard < _MAX_CATCHUP:
		_clock -= sd
		guard += 1
		_on_step()
		var sd2 := step_seconds()
		if not is_equal_approx(sd2, sd):
			if sd > 0.0:
				_clock *= sd2 / sd
			sd = sd2
	if guard >= _MAX_CATCHUP:
		_clock = 0.0          # 丢掉积压，避免"越卡越补"的正反馈


func _on_step() -> void:
	_step_idx += 1
	# ★ 一次读、一次算：`_read_battle_state()` 有副作用（识别"刚落子"⇒ 下一拍重音），
	#   调两次不会出错但会让"这一步用的是哪份读数"变得说不清。
	var st := _read_battle_state()
	# ★ 棋钟：喂的是**同一份**快照（不另读一次 —— 同一条理由）。
	_clock_ext_apply(st)
	var ax := axes_now(st)
	# ★★ 特殊时刻（2026-10-16）：拿**相邻两步**的快照做差分。
	#   同样是"一次读、两处用" —— 用的就是上面那一份，不另读一次
	#   （另读会得到一个与 `ax` 不同步的世界，两边的"现在是哪一步"会对不上）。
	#   `_st_prev` 在**同一处**写入（唯一的写点），所以不存在"两步前的旧值混进来"这种事。
	var cue := _cue_for_step(_step_idx, _st_prev, st)
	_st_prev = st
	# 落子重音：只在**拍点**上给（用户口径是"固定节拍播放音符"，不许抢拍）
	var accent_now := _accent and (_step_idx % maxi(subdiv, 1) == 0)
	_accent = false
	for e in _schedule_step(_step_idx, ax, cue):
		_play_event(e, accent_now)


## 棋钟推来的两个数：目标 BPM 与时间压力。**换速只发生在小节头**（理由见参数组注释）。
## ★ 目标 BPM 为 0（或没有 `clk` 字段）= 没人接管 ⇒ `_bpm_now` 归 0 ⇒ `effective_bpm()`
##   退回基准 `bpm`。这条"撤退路径"是必须的：任何一帧读不到棋钟，音乐都该回到
##   "用户在设置里定的那个速度"，而不是停在上一次棋钟给的值上。
func _clock_ext_apply(st: Dictionary) -> void:
	var want := clampf(_fnum(st.get("clk_bpm", 0.0)), 0.0, 400.0)
	if not clk_follow or want <= 0.0:
		_bpm_now = 0.0
		return
	if (_step_idx % _steps_per_bar()) == 0:
		_bpm_now = clampf(want, clk_bpm_min, clk_bpm_max)


## 每小节的步数。★ **公式单真源**（铁律 18）：`_schedule_step()` 的小节边界与小节头
## 换速判定必须用同一个数 —— 两处各写一遍的话，一处改了一处没改 ⇒ 换速点与和弦点错开，
## 而且两边都不报任何错（音符照发，只是速度换在了半小节上）。
func _steps_per_bar() -> int:
	return maxi(beats_per_bar * maxi(subdiv, 1), 1)


## 琶音的**实际音间距**（秒）—— `arp_step`（步）× 当前步长。
## ★★ **单真源**：调度（`_schedule_step()` 的 `"at"`）、`_arp_fit_seconds()`、
##   判据 ㉘① 的"错开量够不够大"三处**都必须**读它。三处各写一遍
##   `arp_step * step_seconds()` 的话，改口径时漏掉一处是必然的，而且**两边都不报错**
##   （调度用新口径、判据按旧口径量 ⇒ 判据变成一条永远绿的假牙）。
func _arp_gap() -> float:
	return _stagger(maxf(arp_step, 0.0) * step_seconds())


## **错开量总闸**（整个音乐里 `"at"` 的**唯一出口**）：`stagger_scale == 0` ⇒ 恒返回 0.0。
## ★★★ 2026-10-17「怎么还有琶音，都去掉」。为什么必须抽成唯一出口而不是三处各乘一次：
##   "全曲没有一个音是错开起的"是一件**能被一条判据验完**的事（判据 ㊲），
##   而判据只能查它读得到的那个点 —— 三处各乘一次，第四条路（以后新加的乐句/技法/效果）
##   会安静地绕过去，判据照样绿（铁律 13/18：公式单真源）。
## ★ `flatten`（判据 ㉘/㊱ 的旧口径）另有一条"把 at 归零"的路，那是在**读**的时候归零、
##   事件本身不动 —— 两条路的目的不同（这里改**发什么**，那里改**怎么读**），不要合并。
func _stagger(at_raw: float) -> float:
	return maxf(at_raw, 0.0) * clampf(stagger_scale, 0.0, 1.0)


## 错开是否开着 = 那些"靠时间展开"的东西（技法 / 乐句滚动）该不该出场。
## 见 `stagger_scale` 的注释：零错开下倚音会造出小二度、摇指会 4 音叠加、刮奏会成簇。
func _stagger_on() -> bool:
	return clampf(stagger_scale, 0.0, 1.0) > 1e-9


## 和弦音**可用**的余音上限（秒）= 本小节里留给和弦的时间。
##
## 和弦最后一个音起于 `(n-1) × _arp_gap()`，它必须在本小节内衰完，否则
## **相邻两小节的和弦会叠在一起** —— 那正是用户最初抱怨的"糊"的机械原因
## （旧口径 `pad_seconds = 4.0s` 配 3.333s 的小节就是必然重叠，峰值 2× 而不是 1×）。
##
## ★★ 为什么必须是**自适应**而不是把 `arp_seconds` 调小：
##   `arp_seconds` 是**秒**，而小节时长 `spb × step_seconds()` 随 BPM 缩。
##   棋钟一接管，同一份"1.3 秒"在 54 BPM 时只占小节的 0.20、在 200 BPM 时却比一整小节还长。
##   任何**固定秒数**都至少有一个速度档越界 ⇒ 缺陷会在快节奏下静默复活
##   （判据只在默认 72 BPM 上跑，看不到）。按"本小节剩多少时间"收窄则与速度无关。
##
## ★ 用 `CHORD_TONES_MAX`（和弦音数的**硬上界**，不是当前色彩档的值）算占用量：
##   这条要覆盖**所有**色彩档的和弦，跟着 `chord_tones_*` 的插值走会在某个档位漏掉。
## ★ 下限 `0.05s`：`step_seconds()` 极小（极端 BPM）时不让它变成 0 或负数
##   —— 0 会让这个音根本没有余音（听感是"没响"，而且没有任何报错）。
func _arp_fit_seconds() -> float:
	var used := float(maxi(CHORD_TONES_MAX - 1, 0)) * _arp_gap()
	var bar := float(_steps_per_bar()) * step_seconds()
	return maxf(bar - used, 0.05)


# ===== 战况读数（反射；**不改 game.gd**） =====
## 找到"当前对局场景"：必须是场景树当前场景，且声明了 `BATTLE_FIELDS` 里的字段。
## 找不到就返回 null（菜单 / 复盘 / 自检都是这一档 ⇒ 平静态）。
func _game_state_target() -> Node:
	var sc := get_tree().current_scene
	if sc == null:
		return null
	var names: Dictionary = {}
	for p in sc.get_property_list():
		names[str(p["name"])] = true
	# ★ 只要**核心三件**在就算对局场景（`tiles` 之类允许缺席：缺席时密度项按 0 处理，
	#   不会把整条映射打穿）。判据 ⑦ 守的是**源码里**这些名字还在。
	for f in ["black_prisoners", "white_prisoners", "board"]:
		if not names.has(f):
			return null
	return sc


## 读一份战况快照。返回空字典 = "没有对局"（菜单/自检/复盘）⇒ 走平静态。
## ★ 全部走 `get()`（反射），**不 import、不依赖 `game.gd` 的类型** —— 这是与那个
##   正在被并行修改的文件的唯一安全接触方式。
func _read_battle_state() -> Dictionary:
	var sc := _game_state_target()
	if sc == null:
		if not _battle_warned and not GameConfig.is_automated_run():
			_battle_warned = true
			print("[Music] 当前不是对局场景 ⇒ 音乐走平静态（菜单/复盘属正常情况）")
		return {}
	var bd: Dictionary = sc.get("board")
	var tiles: Variant = sc.get("tiles")
	# ★★ 2026-10-07（四轴改造顺手查出来的**第三个同族真缺陷**）：「盘面密度」必须发
	#   **已落子数**，不能发 `bd.size()`。`board` 是"格 → 子色"的字典，初始化时**每一格
	#   都有一条**（EMPTY 也占一条）⇒ `bd.size()` 恒等于格数 = `tiles_total`
	#   ⇒ 密度项恒为 1.0：注释写着"越到后盘越紧"的那个信号**从来没动过**，
	#   `w_density` 实际只提供了一个常量偏置（把节奏轴整体顶到 0.5 附近，
	#   也就是恰好顶在 `stride` 的档位分界上 ⇒ 会在 1/2 之间抖）。
	#   证据：`--analyzetest` 判据⑦ 里 `board_size` 与 `tiles_total` 曾**恒等**。
	var stones := 0
	for k in bd:
		if int(bd[k]) != 0:                 # 0 = Stone.EMPTY（本文件不 import game.gd 的枚举）
			stones += 1
	var st := {
		"black_prisoners": int(sc.get("black_prisoners")),
		"white_prisoners": int(sc.get("white_prisoners")),
		"board_size": stones,
		"tiles_total": (tiles as Array).size() if tiles is Array else 0,
		"passes": int(sc.get("passes")),
		"game_over": bool(sc.get("game_over")),
		"current_player": int(sc.get("current_player")),
	}
	# ★★ 局势层（四轴里三轴的唯一输入）：逐个名字反射读，循环的就是**契约常量本身**
	#   ⇒ "契约表"与"真读的字段"在结构上不可能分家。
	#   缺席的字段**不放进字典**：`st.has(f)` 于是就是最直接的
	#   "生产端到底发了没有"的判据（`--analyzetest` 判据⑦a 用的就是它）。
	var names: Dictionary = {}
	for p in sc.get_property_list():
		names[str(p["name"])] = true
	for f in SITUATION_FIELDS:
		if names.has(f):
			st[f] = sc.get(f)
	st["has_situation"] = _situation_complete(names)
	# ★★ 棋钟快照（2026-10-16）：**可选**字段 —— 缺席时音乐完全不知道棋钟存在
	#   （退回"用基准 bpm"的旧行为）。所以它**不进** `BATTLE_FIELDS`：那是"必须存在"
	#   的清单（缺一个就该红），而棋钟是可以没有的（复盘 / 只跑音乐 / 旧对局场景）。
	#   ⚠️ 但字段**名字**仍是一条契约：把 `clk` 改名 ⇒ 音乐静默退回固定 BPM。
	#      判据⑦ 的源码检查里带上了它（`var clk`），改名当场红。
	var clkv: Variant = sc.get("clk")
	if clkv is Dictionary:
		var cd: Dictionary = clkv
		if not cd.is_empty():
			st["clk_bpm"] = _fnum(cd.get("clk_bpm"), 0.0)
			st["clk_pressure"] = _fnum(cd.get("clk_pressure"), 0.0)
	# 刚落子 ⇒ 下一拍重音（读的是"上一步落子索引"这个单调变化的量）
	var lm: Variant = sc.get("_last_move")
	if lm != null:
		var lmi := int(lm)
		if lmi != _last_move_seen:
			if _last_move_seen >= 0 and lmi >= 0:
				_accent = accent_on_move
			_last_move_seen = lmi
	return st


## 局势层"完整性闸"：真场景是否声明了 `SITUATION_FIELDS` 里的**每一个**名字。
## ★ 为什么拆成一个独立函数（而不是内联在 `_read_battle_state()` 里）：
##   这样"这条闸不是恒真式"本身可以被判据直接验 —— 喂一份**缺一个字段**的名字表
##   必须返回 false（`--musictest` 判据 ㉒ 逐个字段各试一次）。
##   只看"缺了会怎样"是不够的：一条永远返回 false 的闸也能过那种判据。
func _situation_complete(names: Dictionary) -> bool:
	for f in SITUATION_FIELDS:
		if not names.has(f):
			return false
	return true


## 反射读回来的值可能是 null（字段不存在）⇒ 一律过这道闸再进算术。
## ★ 这是"双层设防"的其中一层（铁律 12）：`float(null)` 不是 0，而是一个运行期错误
##   （既污染日志，也让判据读到垃圾）。
func _fnum(v: Variant, dflt: float = 0.0) -> float:
	if v is float:
		return float(v)
	if v is int:
		return float(v)
	if v is bool:
		return 1.0 if v else 0.0
	return dflt


## 「交手烈度 + 进程 + **钟的压力**」标量 0..1 —— **节奏轴的唯一来源**。
## 四项：提子差（交手有多烈）· 盘面密度（打到多后盘）− 停手（该收束了）+ 棋钟压力。
## ★ 为什么把它与 `battle_tension` 分开：改造前这**一个**标量同时驱动了响度/节奏/音高/
##   色彩四个轴 —— "所有东西一起动"正是用户 2026-10-07 那一轮要拆掉的东西。现在它只喂 `tempo`。
## ★★ 2026-10-16（棋钟）：时间压力**并进这里**（而不是另开一路）。理由：`clash_level` 是
##   "节奏轴唯一来源"这条结构约定（见 `axes_from_state()` ②）——在别处再写一次 tempo
##   就是"两处写、一处读漏"。输入量本身由 `game_clock.gd` 提供（它才知道"手频/压力"）。
func clash_level(st: Dictionary) -> float:
	if st.is_empty():
		return 0.0
	var cap_t := clampf(absf(_fnum(st.get("black_prisoners")) - _fnum(st.get("white_prisoners")))
			/ maxf(capture_ref, 0.001), 0.0, 1.0)
	var total := _fnum(st.get("tiles_total"))
	var dens_t := clampf(_fnum(st.get("board_size")) / total, 0.0, 1.0) if total > 0.0 else 0.0
	var calm := clampf(_fnum(st.get("passes")) / 2.0, 0.0, 1.0)
	var clk_t := clampf(_fnum(st.get("clk_pressure")), 0.0, 1.0)
	return clampf(w_captures * cap_t + w_density * dens_t - w_calm * calm
		+ clk_pressure_weight * clk_t, 0.0, 1.0)


## 单标量"紧张度" 0..1 = **退化档的驱动量**（没有局势层时，用它把四轴一起铺开）。
## 三项相加：提子差（激战）、盘面密度（越到后盘越紧）、停手/终局（收束）。
## ★ 判据 ⑥ 用**合成出来的**战况字典核对它的单调性与收束行为 —— 那是纯函数，可断言。
##
## ★★ 2026-10-07：**危机度不再并进这里**。改造前它读 `an_crisis` / `an_live_blocks`，
##   但生产端从来不把这些字段放进快照（两个都成了死参数）；而且就算放进来，
##   把一个标量铺满四个轴，只会让"危险度"同时驱动响度/节奏/音高/色彩 —— 又是同一件事。
##   现在危险度有它自己的轴（响度），这个标量退回纯"规模/进程"口径 = 节奏轴的来源。
func battle_tension(st: Dictionary) -> float:
	if st.is_empty():
		return 0.0
	var t := clash_level(st)
	# ★★ 终局**必须能真正收束**：光靠"减 `w_calm`"不行 —— 满盘时（提子差与密度都拉满）
	#   线性式早就饱和到 1.0，减 0.6 也回不到"该收束"的低档（实测只降到 0.669）。
	#   ⇒ 终局是一个**状态**，不是一次减法：直接夹进收敛区，再由和声侧走主和声收束。
	#   这条是自检判据 ⑥ 逼出来的（首版判据红、代码也红，两边都对不上）。
	if bool(st.get("game_over", false)):
		return minf(t, 0.12)
	return t


# ===== 局势 → 四个轴（响度 / 节奏 / 音高 / 和弦色彩） =====
## ★★★ 本轮改造的核心：**四个轴各读局势的一个不同方面**（而不是一起读同一个标量）。
##
##   响度 ← 危险度 `an_crisis`                      → 每个事件的 gain 乘 `gain_scale`
##   节奏 ← 交手烈度 + 进程（`clash_level`）        → 旋律网格 `stride` + 音符密度
##   音高 ← 优劣 `an_player_diff`（无界目数差）     → 旋律**度数**偏移 `pitch_deg`
##   色彩 ← 形态度 `_form_of()`                    → `_harmony_for_bar()` 的 `hue`
##
## 全是**纯函数**（只依赖传进来的字典）⇒ 在线调度与离线渲染拿到的必然是同一份；
## 也正因为这样，"某个轴是不是死在常量上"才可以直接断言（判据 ⑲/⑳/㉑/㉒ 全在验它）。
##
## ⚠️ 视角纪律（铁律 17）：`an_player_diff` 是**玩家视角**（正 = 玩家目数领先）。
##   消费端**绝不**再乘一个 `sign`、也**绝不**写 `-x`。方向写错是静默的：
##   音乐只会反着演，不会有任何报错。本工程刚在 `game.gd` 里因为"注释说正 = 我方领先、
##   真源其实是黑方视角"栽过一次（AI 落后时危急度反而不涨）。

## 退化档 / 调试档（`tension_percent >= 0`）：把单标量**铺满四轴**。
## ★★ 关键约定：这一档必须与**旧的四轴口径逐字节同输出**（`gain_scale = 1.0`、`stride = 1`、
##   `pitch_deg = 0`、`hue = t`）。`--musicdump` 的验收 wav 走的正是这一档。
##   ★★★ 2026-10-16 精确化：这一档保证的是"**四轴**没有被顺手动坏"，它**不**保证整曲件的
##   md5 不变 —— 本轮改的是**调度层与和声层**（和弦琶音化 / 音数按色彩插值），
##   那一层的改动落在**所有**档位上，退化档也不例外。所以：
##     · 改**本函数**（这一档本身）⇒ 必须先确认锚件失配、再更新锚件，不许"顺手调一下"；
##     · 改**调度/和声层** ⇒ 整曲件会变，那是**预期**的；但必须同时证明
##       **DSP 单音件逐字节不变**（`music_accept_note.wav` md5 61043c95…），
##       否则分不清"改的是调度"还是"顺手把合成器也改了"。
func axes_from_tension(t: float) -> Dictionary:
	var tt := clampf(t, 0.0, 1.0)
	return {
		"loud": tt, "gain_scale": 1.0,
		"tempo": tt, "stride": 1,
		"pitch": 0.0, "pitch_deg": 0,
		"hue": tt, "form": tt,
		"crisis": tt,
		# ★★ 这一档（退化档 / `--musicdump` 验收档）的 `pressure` **必须是 0**：
		#   它是"离线验收件不带棋钟读秒声"的保证。给它任何非 0 值都会让读秒声在离线渲染里
		#   冒出来 ⇒ 验收件里混进一个与"听曲子"无关的短促音（而且每拍一个，很显眼）。
		"pressure": 0.0,
		"src": "tension",
	}


## 节奏轴的第二个落点：旋律的**网格**（1 = 每步都发；2 = 每两步才发一次 ⇒ 听感慢一倍）。
## ★ 量化成整数（`round`）不是洁癖：`stride` 参与 `in_bar % stride`，不是整数会静默走样。
func _stride_of(tempo: float) -> int:
	return clampi(int(round(lerpf(rhythm_stride_calm, rhythm_stride_tense,
		clampf(tempo, 0.0, 1.0)))), 1, 8)


## 形态度 0..1 = 双方 已活 / 可做活 / 已死 三类**块数**的加权比例。
##   · 空盘 / 全部已活 ⇒ 0（形已定、胜负已明 ⇒ 平静）
##   · 全盘未定形      ⇒ `form_unsettled_weight`（默认 0.55 ⇒ 落在中档）
##   · 出现死块        ⇒ 推向 1（真的碎在盘上 ⇒ 最高档 + 偏音）
## ★ 用**块数**而不是子数：音乐要表达的是"局面里还有多少处说不清的地方"，
##   一块 30 子的活棋与一块 2 子的活棋在"形态度"上是同一件事。
func _form_of(st: Dictionary) -> float:
	var live := _fnum(st.get("an_live_blocks")) + _fnum(st.get("an_player_live_blocks"))
	var unsettled := _fnum(st.get("an_unsettled_blocks")) + _fnum(
			st.get("an_player_unsettled_blocks"))
	var dead := _fnum(st.get("an_dead_blocks")) + _fnum(st.get("an_player_dead_blocks"))
	var tot := live + unsettled + dead
	if tot <= 0.0:
		return 0.0
	return clampf((unsettled * form_unsettled_weight + dead * form_dead_weight) / tot, 0.0, 1.0)


## 有局势层时：四轴各读一个**不同**的信号。
func axes_from_state(st: Dictionary) -> Dictionary:
	if st.is_empty():
		return axes_from_tension(0.0)
	# ① 响度 ← 危险度。★ 直接读 `an_crisis`（= game.gd 侧算好的 max(玩家, AI)）：
	#   同一套公式只能有一个真源（铁律 18），这里不重算 max。
	var crisis := clampf(_fnum(st.get("an_crisis")), 0.0, 1.0)
	# ② 节奏 ← 交手烈度 + 进程
	var tempo := clash_level(st)
	# ③ 音高 ← 优劣（玩家视角的**无界**目数差；"几目算拉满"的尺子就在这里）
	var pdiff := _fnum(st.get("an_player_diff"))
	var pitch := clampf(pdiff / maxf(point_ref, 0.001), -1.0, 1.0)
	# ④ 色彩 ← 形态度
	var form := _form_of(st)
	# ⑤ 读秒声 ← 时间压力（棋钟）。★ 这一项**不进** `clash_level` 之外的通路：
	#   它自己有一条落点（`_schedule_step` 里的 tick 事件），节奏轴拿到的是同一个量。
	var press := clampf(_fnum(st.get("clk_pressure")), 0.0, 1.0)
	var ax := {
		"loud": crisis, "gain_scale": lerpf(loud_min_scale, loud_max_scale, crisis),
		"tempo": tempo, "stride": _stride_of(tempo),
		"pitch": pitch, "pitch_deg": int(round(pitch * float(pitch_span_deg))),
		"hue": form, "form": form,
		"crisis": crisis, "pdiff": pdiff,
		"pressure": press,
		"src": "state",
	}
	# ★ 终局收束（与 `battle_tension()` 同一条口径）：满盘时提子差与密度都拉满，
	#   节奏项自己降不下来 ⇒ 必须**显式**把四轴压到收束档。
	#   ★ 棋钟压力也要一并归零：终局后钟停走，但压力值会停在"最后一手"那一刻 ——
	#     不收的话比赛结束后读秒声还在"滴答"，而音乐已经进了收束档（同屏矛盾）。
	if bool(st.get("game_over", false)):
		ax["loud"] = 0.0
		ax["gain_scale"] = loud_min_scale
		ax["tempo"] = 0.0
		ax["stride"] = _stride_of(0.0)
		ax["pitch"] = 0.0
		ax["pitch_deg"] = 0
		ax["hue"] = 0.0
		ax["form"] = 0.0
		ax["pressure"] = 0.0
	return ax


## 唯一入口（喂一份已经读到的快照）：有局势层 ⇒ 四轴；没有 ⇒ 退回单标量档。
## ★ 那个 `has_situation` 闸不是可选项：缺了它，一场"game.gd 少发一个字段"的事故
##   会表现成"音乐的四个轴同时不动"，而且没有任何报错。有了它 ⇒ 明确退回**旧口径**
##   （能听出来的行为变化），同时判据⑦（静态）与判据㉒（运行期）都会红。
func axes_from(tension: float, st: Dictionary) -> Dictionary:
	if bool(st.get("has_situation", false)):
		return axes_from_state(st)
	return axes_from_tension(tension)


## 这一步该用哪套四轴。`tension_percent >= 0` ⇒ 强制档（调音/截图），否则随战况。
func axes_now(st: Dictionary) -> Dictionary:
	if tension_percent >= 0:
		return axes_from_tension(float(tension_percent) / 100.0)
	return axes_from(battle_tension(st), st)


## 当前四轴（自己读一次战况）。**给外部读**（游戏侧判据 / 调试）——
## 调度路径用的是 `axes_now(st)`：`_on_step()` 需要把**同一份**快照喂给两边。
func current_axes() -> Dictionary:
	return axes_now(_read_battle_state())


# ===== 曲风（`STYLES` 的**唯一**读取点）=====
## 生效的曲风表：正常是常量 `STYLES`，自检注入时是 `_style_table_override`。
## ★ 真源只有一处（这条在守卫 S104 里钉着）：除了这里，别处一律不许直接索引 `STYLES`。
func style_table() -> Dictionary:
	return _style_table_override if not _style_table_override.is_empty() else STYLES


## 当前曲风（`style_id`）的定义字典 —— **全部曲风相关取值都从这里读**。
## 非法 id 的处置：提示一次 + 回退到**表里的第一项**。
## ★★ 回退为什么先找 `STYLE_IDS[0]`、找不到再取表的第一键：这样它对"表被换掉"
##   （自检注入、或将来允许运行期加载曲风包）也是稳的，而不是在那种情况下返回 null
##   让整条调度链静默崩掉（那正是判据 ㉜ 要防的方向）。
func _style() -> Dictionary:
	var tbl := style_table()
	var s: Variant = tbl.get(style_id)
	if s is Dictionary:
		return s
	var fb := ""
	if tbl.has(STYLE_IDS[0]):
		fb = STYLE_IDS[0]
	elif not tbl.is_empty():
		fb = String(tbl.keys()[0])
	if not _style_warned:
		_style_warned = true
		push_warning("[Music] 未知曲风 id「%s」⇒ 回退「%s」（合法值见 STYLE_IDS）" % [style_id, fb])
	return tbl[fb]


## 当前曲风的**音阶半音表**（第一个元素 = 主音 = 0）。
func style_scale() -> Array:
	return _style()["scale"]


## 当前曲风的**三档和声进行**（已活 / 未定形 / 有死块），每档 = 一小节的度数序列。
func style_progs() -> Array:
	return _style()["progs"]


## 当前曲风的**技法细节**（间隔 / 反复次数 / 刮奏音数 / 泛音八度与音量）。
## ★ 细节属曲风本体、概率属 `@export` 旋钮 —— 见 `STYLES` 的注释。
func style_tech() -> Dictionary:
	return _style().get("tech", {})


# ===== 和声 =====
## 把"音阶内第 n 步"折算成半音数（跨八度自动 +12）。n 可以是负数/超过一圈。
## ★★ 音阶来自**当前曲风**（`style_scale()`）—— 这就是"换曲风 = 换音高材料"的落点。
## `k <= 0` 的兜底：一条空音阶会让下一行除零而崩。判据 ㉜ 对每个曲风都断言"非空且升序"，
## 所以正常永远走不到这一行；它存在是为了"表被改坏"时只退化成"音高不动"，而不是炸掉整条调度链。
func pent_at(n: int) -> int:
	var sc := style_scale()
	var k := sc.size()
	if k <= 0:
		return 0
	var oct := int(floor(float(n) / float(k)))
	var i := ((n % k) + k) % k
	return 12 * oct + int(sc[i])


## 这一小节的**和声色彩**：只吃 `hue`（= 形态度，0 平静 ~ 1 紧绷）。
## **纯函数**（只依赖 bar 与 hue）⇒ 在线调度与离线渲染拿到的是同一份。
##
## ★★ 2026-10-07 收窄：改造前这个函数还兼管 `density` / `oct_span` / `bpm_mul`，
##   于是一个标量同时决定了"和声选材"与"节奏"。现在它**只**决定色彩，
##   另外两样搬去 `_schedule_step()`（那里才有节奏轴）。
##   `bpm_mul` 直接删掉：它算出来之后**从来没被读过**（死参数，见 `rules.md` §22）——
##   而且它那条路本来就走不通：改 `bpm` 会让 `step_seconds()` 在小节中途变，
##   `_advance()` 的时钟与新步长不同步 ⇒ 拍与拍之间会**漂移**。节奏改用 `stride`。
##
## ★★★ 2026-10-16 和弦瘦身（用户口令：「减少同时弹奏的和弦（听起来有点吵）」）：
##   改造前 = **固定 3 个音 + 张力满时第 2/3 音各抬高一个八度 + 再追加一个偏音** ⇒ 小节头
##   最多 **4 个音同时起**，而且每个音带着 `pad_seconds = 4.0` 秒的尾巴（小节只有 3.33 秒）
##   ⇒ 相邻小节的和弦永远叠着，实测同时发声峰值上到 8~10 个。
##   现在三条一起改：
##     ① **音数**　由 `chord_tones_calm..chord_tones_tense` 按色彩插值（默认 2~3），**取消八度加倍**；
##     ② **偏音**　最高张力档用"**替换顶音**"而不是"追加一个音" ⇒ **音数不随色彩增加**，
##                 同时发声数因此有一个**与色彩无关的硬上界**（这条是可断言的，见判据 ㉘）；
##     ③ **琶音**　音与音之间错开 `_arp_gap()` = `arp_step` 个**最小步长**
##                 （在 `_schedule_step()` 里，它是调度不是和声；单位是"步"而不是秒，
##                  见 `arp_step` 的注释：秒与节拍无关，而这个工程的节拍会随棋钟变）。
##   ★ 度数栈 `[0, 2, 4, 5]`（宫—角—羽—高八度宫）比原来的三度叠置更"中国"：
##     五声音阶里的"三度"本来就是附加音和弦，而"根 + 五度 + 八度"是古筝琶音的常型。
func _harmony_for_bar(bar: int, hue: float) -> Dictionary:
	var hh := clampf(hue, 0.0, 1.0)
	var progs := style_progs()
	var pidx := 0
	if hh >= HUE_HIGH:
		pidx = 2
	elif hh >= HUE_MID:
		pidx = 1
	if progs.is_empty():
		return {"deg": 0, "chord": [root_midi] as Array[int], "root": root_midi, "high": false}
	var prog: Array = progs[clampi(pidx, 0, progs.size() - 1)]
	if prog.is_empty():
		return {"deg": 0, "chord": [root_midi] as Array[int], "root": root_midi, "high": false}
	var deg := int(prog[((bar % prog.size()) + prog.size()) % prog.size()])
	var high := hh >= HUE_HIGH
	# 音数：按色彩在"平静档音数 → 张力满档音数"之间插值，夹进合法区间。
	var n := clampi(int(round(lerpf(float(chord_tones_calm), float(chord_tones_tense), hh))),
		CHORD_TONES_MIN, CHORD_TONES_MAX)
	# 度数栈：取前 n 级。`stack` 的长度 == CHORD_TONES_MAX ⇒ 里面没有取不到的成员。
	var stack := [0, 2, 4, 5]
	var chord: Array[int] = []
	for i in n:
		chord.append(root_midi + pent_at(deg + int(stack[i])))
	if high:
		# 色彩最高档：**把顶音抬高一个八度**（敞开排列），而**不是**换成刺耳的偏音。
		# ★★★ 2026-10-17 改（用户口令：「好好调整和弦，让它更和谐就好」）。
		#   旧做法是 `chord[n-1] += (1 if bar % 2 == 0 else 6)`
		#   —— 也就是把顶音换成**小二度（+1）或三全音（+6）**的阶外音，交替出现。
		#   在**琶音**口径下它只是"末端一点不安的色彩"，因为三个音是依次响的；
		#   但用户这一轮要求**齐奏** ⇒ 那个小二度会**同时**撞在其余和弦音上，
		#   变成持续的、极刺的高频拍频 —— 这正是"吵"的机械来源之一。
		#   ⇒ 改成把顶音升八度："更亮、更开"同样是一种色彩，而它**全是协和音程**。
		# ★ 音数不变（"音数不随色彩增加"这条不变量仍然成立，只是换了实现方式）。
		chord[n - 1] = chord[n - 1] + 12
	return {
		"deg": deg,
		"chord": chord,
		"root": root_midi + pent_at(deg),
		"high": high,
	}


## 旋律的**音阶内度数**：`h["deg"]`（本小节的和声度数）+ 一个五声内的小步进 + 音高轴偏移。
## ★★ 单真源：`_pick_degree()`、刮奏的起点、倚音的邻音**全都从这里取** ——
##   两处各写一份步进表的话，"刮奏落在哪儿"和"旋律落在哪儿"会慢慢分家，
##   而且分家的方向（刮奏结束在旋律下方一个随机距离）是**听得出来但查不出来**的。
func _pick_degree_idx(rng: RandomNumberGenerator, h: Dictionary, off: int = 0) -> int:
	var deg := int(h["deg"])
	var steps := [-2, -1, 0, 1, 2, 3, 4]
	return deg + int(steps[rng.randi_range(0, steps.size() - 1)]) + off



# ===== 特殊时刻（乐句）=====
## 相邻两步快照的**差分** → 一个时刻名（`CUE_IDS` 里的一个）或 ""。**纯函数**。
##
## ★★★ 用户口令：「加入特殊时刻触发特殊旋律（吃子、做活、终局等）」。
##   改造前这套音乐**没有"事件"这个概念** —— 只有情绪随战况连续地变（四轴），
##   所以吃了一条大龙和随手一压，听起来是一样的。这一节补的就是那个维度。
##
## ★★ 为什么"零改 game.gd"能做到（这是与那个文件唯一安全的接触方式，同 `BATTLE_FIELDS`）：
##   所有判据都是**差分**（提子数变了 / 活块数变了 / 终局翻转 / 危急度越闸），
##   不需要对局侧发任何事件。代价是两件必须自己扛的事：
##     ① "上一步的读数"得由音乐侧自己记（`_st_prev`）；
##     ② 检测**必然滞后一步**（≤ 一个步长，72BPM/半拍 = 0.42 秒）。
##   滞后是可接受的：乐句是"对刚发生的事的评论"，不是音画同步的特效。
##
## ★ 顺序即优先级（见 `CUE_IDS`）：一个时刻只放一句乐句，从前往后取第一个命中的。
##   终局在最前面 —— 它是"这一局结束了"，任何别的事件都不该盖过它。
func _detect_cue(prev: Dictionary, cur: Dictionary) -> String:
	# 没有上一步（刚起音乐）或当前没有对局（菜单/复盘/自检）⇒ 不是事件。
	# ★ 这一行同时挡掉"从 0 变成 3 个提子"那种**首次读数**：那不是吃子，是第一次看见。
	if prev.is_empty() or cur.is_empty():
		return ""
	if bool(cur.get("game_over", false)) and not bool(prev.get("game_over", false)):
		return "end"
	# 危急：只看"从闸**下方**越过闸"这一次。写成"当前在闸上方"就会每步都触发
	# —— 而 `an_crisis` 一旦上去往往会停在高位好几步，那就成了"一直响"。
	var c_prev := _fnum(prev.get("an_crisis"))
	var c_cur := _fnum(cur.get("an_crisis"))
	if c_cur >= cue_crisis_gate and c_prev < cue_crisis_gate:
		return "crisis"
	# 提子：**双方之和**的增加（不分谁提的 —— 音乐表达的是"盘上发生了吃子"这件事；
	# 谁占便宜由响度轴与音高轴去表达，那是另外两个轴的事，不许在这里重复一遍）。
	var p_prev := _fnum(prev.get("black_prisoners")) + _fnum(prev.get("white_prisoners"))
	var p_cur := _fnum(cur.get("black_prisoners")) + _fnum(cur.get("white_prisoners"))
	var gained := p_cur - p_prev
	if gained >= float(cue_big_capture):
		return "big_capture"
	if gained > 0.0:
		return "capture"
	# 块死：双方"救不回来"的块数之和增加。
	var d_prev := _fnum(prev.get("an_dead_blocks")) + _fnum(prev.get("an_player_dead_blocks"))
	var d_cur := _fnum(cur.get("an_dead_blocks")) + _fnum(cur.get("an_player_dead_blocks"))
	if d_cur > d_prev:
		return "dead"
	# 做活：双方"已活"块数之和增加。
	var l_prev := _fnum(prev.get("an_live_blocks")) + _fnum(prev.get("an_player_live_blocks"))
	var l_cur := _fnum(cur.get("an_live_blocks")) + _fnum(cur.get("an_player_live_blocks"))
	if l_cur > l_prev:
		return "life"
	return ""


## 带**总开关**与**冷却**的取用口（有状态的那一半）。`k` = 单调步号。
## ★ 冷却为什么必须有：`an_live_blocks` / `an_dead_blocks` 在相邻几步里会**反复抖动**
##   （AI 侧每步都可能重新划块）⇒ 没有冷却就成了"每步换一句乐句"，那是噪音不是音乐。
## ★ 为什么**不**额外要求"只在拍点触发"：那会让"这一步检测到、下一步差分已经消失"的
##   事件被整条丢掉（乐句是**事件**驱动，不是节拍驱动）。乐句内部的 `at` 偏移本来就
##   落在这一个步长之内，不会跨到下一步 —— "不抢拍"这件事由格子（`_steps_per_bar()`）管，
##   而格子纹丝不动。
func _cue_for_step(k: int, prev: Dictionary, cur: Dictionary) -> String:
	if not cue_enabled or k < _cue_until_step:
		return ""
	# 没有局势层 ⇒ 做活/块死/危急三个时刻根本读不到（字段不存在）。
	# 统一在这一层挡住，不散到 `_detect_cue()` 里 —— 那个函数要保持"纯差分"，
	# 才可能被单独喂两份手写的快照直接断言（判据 ㉙）。
	if not bool(cur.get("has_situation", false)):
		return ""
	var c := _detect_cue(prev, cur)
	if c != "":
		_cue_until_step = k + maxi(cue_cooldown_bars, 0) * _steps_per_bar()
	return c


## 把时刻名展开成事件表。**纯函数**（只依赖 cue / 曲风表 / `cue_gain`）。
##
## ★★ 乐句库有**两套互斥的记号**，这是它可被断言的关键（判据 ㉛ 两面都验）：
##   · `deg`  —— **音阶度数**（相对 `root_midi + 12`，可负 = 低八度）⇒ 展开出来的音
##               **必须落在当前曲风的音阶上**；
##   · `semi` —— **半音**（相对 `root_midi + 12`）⇒ 展开出来的音**必须落在音阶之外**。
##     `semi` 存在的理由很具体：古筝的"苦音/按音"就是**故意**把一个音按出音阶
##     （危急那一刻的 `semi: [11]` 就是它）。把两者混成一套记号的话，
##     "这个偏音是故意的还是手滑写错了"就再也分不出来 —— 而那是两种完全不同的处置。
func _cue_events(cue: String) -> Array[Dictionary]:
	var evs: Array[Dictionary] = []
	var bank: Variant = _style().get("cues", {})
	if not (bank is Dictionary):
		return evs
	var defd: Variant = (bank as Dictionary).get(cue)
	if not (defd is Dictionary):
		if not _cue_warned:
			_cue_warned = true
			push_warning("[Music] 曲风「%s」的乐句库里没有「%s」⇒ 该时刻不出声（判据 ㉛ 会红）"
				% [style_id, cue])
		return evs
	var base := root_midi + 12
	for seg in (defd as Dictionary).get("segs", []):
		if not (seg is Dictionary):
			continue
		var sd: Dictionary = seg
		var degs: Array = sd.get("deg", [])
		var semis: Array = sd.get("semi", [])
		var ats: Array = sd.get("at", [])
		var kind := str(sd.get("kind", "note"))
		var g := float(sd.get("gain", 0.40)) * cue_gain
		var n_ev := maxi(degs.size(), semis.size())
		# ★★★ 2026-10-17「怎么还有琶音，都去掉」：乐句里的 `at` 数组
		#   （0.0/0.12/0.24/0.36…）也是滚动 —— 特殊时刻的长乐句里甚至有 7~8 个音
		#   在 0.4 秒内跑完（那本来就是"刮奏"型的收句）。
		#   ⇒ 零错开时每个 seg **只发落点音**（最后一个），而不是把它们压成同一刻：
		#     跑动型 seg 压成同一刻 = 一个音簇；摇指型 seg（`[3,3,3,3]`）= 4 个同音叠加
		#     （增益 ×4）。落点音才是乐句的和声意图，也是"滚动"这件事的终点。
		#   ★ 拧上 `stagger_scale` 后逐字回到原设计（每个音按自己的 `at` 起）。
		var i0 := 0 if _stagger_on() else maxi(n_ev - 1, 0)
		for i in range(i0, n_ev):
			var m := base
			if not degs.is_empty():
				m += pent_at(int(degs[i]))
			else:
				m += int(semis[i])
			evs.append({"midi": m, "kind": kind, "gain": g,
				"at": _stagger(float(ats[i]) if i < ats.size() else 0.0)})
	return evs


## ★★ **调度真源**：第 k 步要发哪些音。**纯函数**（只依赖 k、四轴与 cue，随机数由 k 播种）
##    ⇒ ① 在线播放与离线渲染必然一致（判据与耳朵听的是同一个东西）；
##       ② 判据 ⑩/⑳（同输入两次结果逐字相同）才可能成立 —— 可复现是"能当判据"的前提。
##
## 各轴的落点（都在这个函数里，一眼能看出"哪个轴动了什么"）：
##   · `gain_scale`（响度）→ **每个**事件的 `gain` 都乘它
##   · `stride`（节奏）    → 旋律（以及火花）走粗一级的网格；**小节头的和弦照发**
##   · `tempo`（节奏）     → `density`（每步发声音的概率）
##   · `pitch_deg`（音高） → 旋律的度数偏移
##   · `hue`（色彩）       → 交给 `_harmony_for_bar()`
##   · `pressure`（棋钟）  → 过闸时每拍补一个短促读秒声
##   · `cue`（**不是轴**，是参数）→ 事件乐句：**取代**本步的旋律与火花
##
## ★ `cue` 的默认值是 `""` ⇒ **旧调用点逐字不变**（自检里那些 `_schedule_step(k, ax)`
##   与"这一步没有特殊时刻"完全等价）。这条就是判据 ㉚ 的退化档。
func _schedule_step(k: int, ax: Dictionary, cue: String = "") -> Array[Dictionary]:
	var evs: Array[Dictionary] = []
	# ★ `_steps_per_bar()` 是**单真源**（与 `_clock_ext_apply()` 的小节头判定同一处）——
	#   在这里另写一次 `beats_per_bar * subdiv` 的话，换速点与和弦点会悄悄错开。
	var spb := _steps_per_bar()
	var bar := int(k / spb)
	var in_bar := k % spb
	var h := _harmony_for_bar(bar, float(ax.get("hue", 0.0)))
	var gs := maxf(_fnum(ax.get("gain_scale", 1.0), 1.0), 0.0)   # 响度轴
	var stride := maxi(int(_fnum(ax.get("stride", 1.0), 1.0)), 1)  # 节奏轴（网格）
	var tempo := clampf(_fnum(ax.get("tempo", 0.0)), 0.0, 1.0)
	var density := lerpf(density_calm, density_tense, tempo)     # 节奏轴（密度）
	var pdeg := int(_fnum(ax.get("pitch_deg", 0.0)))             # 音高轴（度数偏移）
	# ★★★ 2026-10-16 深夜记一笔**查过但结论是"不用改"**的事，免得下次重新怀疑一遍：
	#   判据 ㊱ 最初在 **8 小节**窗口上量到"张力满档 64 步里 `note` 只有 39 个，
	#   而 `64 × (density_tense + SPARK_CHANCE) = 53.7`" ⇒ 一度怀疑"每步
	#   `rng.seed = 小整数` 之后头两次 `randf()` 有偏，恰好打在密度闸与火花闸上"。
	#   用独立最小工程把这条查到底（工作区 `_rngprobe/`，四种播种方案对拍）：
	#     · 只取 `_schedule_step()` 真实用到的那 64 个种子 ⇒ 首抽样确实偏低（35/64）；
	#     · 但把同样的公式铺到 **4096 个种子**（`bar` 0..511）⇒ 首抽样 `< 0.68` 的
	#       比例 **0.6792**（期望 0.6800）、均值 **0.5007**（期望 0.5000）—— **完全均匀**；
	#     · 同一小节 8 步（种子是连续整数）之间**也没有相关性**：发声率 0.6801、
	#       小节内发声音数的方差 1.7601（独立=1.7408）⇒ **不成簇**。
	#   ⇒ 结论：**播种方式没有问题**，那 64 个种子只是"一次落在 −2σ 上的抽样"，
	#     而 `_schedule_step()` 的种子随 `bar` 一直往后走 ⇒ **长程无偏**。
	#     ★ 真正的问题在**判据那一侧**：8 小节窗口只有 32 个平静档槽位，
	#       静默占比的抽样噪声约 ±0.07 ⇒ 拿它定界会得到一条会自己漂的判据。
	#       修法是**把窗口加长**（㊱ 用 32 小节），不是去动随机源。
	#     ★★ 这条记下来的价值在于：它挡住了一个"看起来很像修复"的改动
	#       （把种子过一遍 splitmix64 —— 实测只会把 8 小节窗口的抽样换成另一次，
	#       长程统计一模一样）。铁律 71：判据与数据矛盾时先疑判据。
	var rng := RandomNumberGenerator.new()
	rng.seed = 20261005 + bar * 131 + in_bar
	# ① 小节头：和弦 —— **默认齐奏**（`arp_step = 0` ⇒ 所有和弦音 `at = 0` 同时起）。
	#    ★★★ 2026-10-17：用户听过琶音之后判定「琶音太吵」，要**齐奏**。
	#    机制没变（仍然是"错开量 = `_arp_gap()`"），只是默认值降到 0：
	#    这一行在 `arp_step > 0` 时照样能摊成琶音，`arp_step = 0` 时 `gap * i` 全为 0。
	#    ★ 错开量走 `_arp_gap()`（**单真源**）而不是在这里写 `arp_step * step_seconds()`：
	#      判据要量"这个错开量够不够大"，两边必须读同一个数，否则判据会变成假牙。
	#
	# ★★★ 齐奏下**增益必须重新配平**（这是"更和谐"里最容易被忽略的一半）：
	#   琶音时三个音相隔 0.417s 起音，峰值**不叠加**，所以旧值 `0.60 / 0.34 / 0.34` 没问题；
	#   齐奏时它们在**同一采样点**起音 ⇒ 峰值直接相加 `0.60+0.34+0.34 = 1.28`，
	#   比旋律音（0.46）响将近三倍，还会把总线推过 1.0（听感上是"炸"而不是"和声"）。
	#   ⇒ 改成 `0.34 / 0.19`：三音合计 0.72、四音合计 0.91，都留在余量里；
	#     而"根音略重"的层次仍然保留（根音听得出是根音）。
	#   ★ 判据不判这两个数（它们是音色，不是约束）—— 但 `CHORD_BANNED_ICS` 判的是
	#     **音程**，那才是"和谐"的可判形式；这一行只管别把总线顶爆。
	if in_bar == 0:
		var chord: Array = h["chord"]
		var gap := _arp_gap()
		for i in chord.size():
			evs.append({"midi": int(chord[i]), "kind": "arp",
				"gain": (0.34 if i == 0 else 0.19) * gs,
				"at": gap * float(i)})
	# ★★ 读秒声（棋钟，2026-10-16）：压力过闸时**每拍**一个短促高音。
	#   两个位置细节都是有意的：
	#   · 放在 **stride 早退之前** —— 它是钟的心跳，不是旋律。被网格筛掉的话，
	#     最紧张的时候（tempo 高 ⇒ stride 反而是 1…但低压力档 stride=2）读秒会走一隔一，
	#     听感上变成"两拍一响"，与"还剩几秒"完全脱钩。
	#   · 只给在**拍点**上（`in_bar % subdiv == 0`）—— 与落子重音同一条"不许抢拍"的纪律
	#     （用户 2026-10-05 定的口径：固定节拍播放音符）。
	var press := clampf(_fnum(ax.get("pressure", 0.0)), 0.0, 1.0)
	if press > clk_tick_gate and (in_bar % maxi(subdiv, 1)) == 0:
		# 闸以上线性展开：刚过闸时几乎听不见，压力满时给足 `clk_tick_gain`
		var amt := (press - clk_tick_gate) / maxf(1.0 - clk_tick_gate, 0.001)
		evs.append({"midi": clk_tick_midi, "kind": "tick",
			"gain": clk_tick_gain * clampf(amt, 0.0, 1.0) * gs})
	# ③ 特殊时刻乐句：**取代**本步的旋律与火花（不是叠上去）。
	#   ★ 为什么是"取代"而不是"叠加"：乐句本身已经是一句完整的话，再往上叠一条旋律，
	#     听感就变成"两件事同时发生" —— 那正是用户要减少的"同时弹奏"。
	#   ★ 小节头的琶音**不**被取代：它是"这一小节什么色彩"的载体，与乐句并不冲突；
	#     而且它已经错开了起音，不是"齐奏叠齐奏"。
	if cue != "":
		for e in _cue_events(cue):
			var ce: Dictionary = e.duplicate()
			ce["gain"] = float(e["gain"]) * gs
			evs.append(ce)
		return evs
	# ★ 网格（`stride`）只筛**旋律/火花**，不筛小节头的和弦：和弦是"这一小节是什么色彩"
	#   的载体，把它筛掉会让低节奏档的整小节**只剩一个音**（听起来像掉帧，不像放慢）。
	if stride > 1 and (in_bar % stride) != 0:
		return evs
	if rng.randf() < density:
		_append_melody(evs, rng, h, pdeg, gs, tempo)
	if bool(h["high"]) and rng.randf() < SPARK_CHANCE:
		# 色彩最高档：稀疏的高音"火花"，仍在格子上。
		# ★★ 2026-10-17：原来是 `+ (1 if rng.randf() < 0.5 else 6)` —— 又是**小二度 / 三全音**
		#   的阶外音。它单独响时只是"一点亮色"，但它落在**齐奏和弦的长余音之上**
		#   ⇒ 与和弦里的音形成持续拍频，是"吵"的另一半来源（用户「好好调整和弦」）。
		#   ⇒ 改成阶内的大六度（`pent_at(4)` = 9 半音）：仍是高音区的一抹亮色，但落在和声里。
		evs.append({"midi": int(h["root"]) + 24 + pent_at(4),
			"kind": "note", "gain": 0.18 * gs})
	return evs


## 旋律槽：**一个槽最多发一件事** —— 单音 / 摇指 / 刮奏+单音 / 倚音+单音，另外可能补一个泛音。
##
## ★★★ 技法为什么挂在"槽"上（这是本轮最容易做错的一处）：`density` 决定的是
##   "这一步有没有旋律"，技法只改变**怎么弹**。另开一路（"技法自己决定要不要额外发个音"）
##   会让技法把音符密度偷偷抬上去 —— 那正好是"减少同时弹奏"的反面，而且听感上表现为
##   "开了技法之后整体变吵"，与"技法让旋律更好听"混成一件事，再也没法分开评。
##
## ★ 四种技法：摇指/刮奏/倚音用**一次抽取**互斥地选一个（它们在演奏上本来就不共存），
##   泛音是独立的一路（它是"加亮点"，不是"换奏法"）。这样每个 `tech_*` 旋钮都单独可测
##   —— 四个旋钮各自有牙，见判据 ㉝（它把每个旋钮单独拉满/归零，两面都验）。
func _append_melody(evs: Array[Dictionary], rng: RandomNumberGenerator, h: Dictionary,
		pdeg: int, gs: float, tempo: float) -> void:
	var di := _pick_degree_idx(rng, h, pdeg)
	var oct_up := rng.randi_range(0, maxi(int(oct_span if bool(h["high"]) else 1) - 1, 0))
	var midi := root_midi + pent_at(di) + 12 * oct_up
	var tc := style_tech()
	var tstep := maxf(_fnum(tc.get("step"), 0.075), 0.01)
	# ★★★ 2026-10-17「怎么还有琶音，都去掉」：**技法本身就是琶音** ——
	#   摇指 = 同一个音快速反复 3~4 次、刮奏 = 4~7 个音在 0.45 秒内上行，
	#   而四个旋钮默认 0.25~0.30 ⇒ 几乎每一步都有 1/4 的概率窜出一串音。
	#   和弦改成齐奏之后，"怎么还有琶音"指的就是这里。
	#   ⇒ 零错开（`_stagger_on() == false`）时**摇指/刮奏/倚音整体不出场**。
	#     ★ 这不是"顺手关掉"，是硬约束：零错开下 倚音 = 目标音与下行邻音**同时**响
	#       = 小二度（正是刚立进 `CHORD_BANNED_ICS` 的那个音程）；摇指 = 4 个同音同时
	#       ⇒ 该音增益 ×4；刮奏 = 4~7 个音同时 ⇒ 音簇。三种都会立刻破坏 ㉘④。
	#   ★ **泛音例外**（保留）：它不是"一串"，是旋律的八度亮点（ic0，不构成任何紧张），
	#     零错开下它只是"同一刻更亮一点"，不产生琶音也不产生簇。
	var tech_on := _stagger_on()
	var roll := rng.randf()
	if tech_on and roll < tech_tremolo:
		# 摇指：目标音快速反复。★ 反复次数随张力上升（古筝摇指本来就是"越急越摇"），
		#   3 次是下限 —— 少于 3 次听不出"摇"，只会被听成"手抖了一下"。
		var reps := maxi(int(round(lerpf(3.0, maxf(_fnum(tc.get("tremolo_reps"), 4.0), 3.0),
			clampf(tempo, 0.0, 1.0)))), 3)
		for i in reps:
			evs.append({"midi": midi, "kind": "orn", "gain": 0.30 * gs,
				"at": _stagger(tstep * float(i))})
	elif tech_on and roll < tech_tremolo + tech_gliss:
		# 刮奏：从低处**快速上行**到目标音 —— 古筝最标志性的连接法。
		# ★ 起点由 `_pick_degree_idx()` 那**同一个度数**往下数（不另取一个随机音高）：
		#   否则"刮奏落在哪"与"旋律落在哪"各自随机，刮奏就不再"指向"旋律音，
		#   听起来会像两件不相干的事碰巧同时发生。
		var nn := maxi(int(_fnum(tc.get("gliss_notes"), 4.0)), 1)
		for i in nn:
			evs.append({"midi": root_midi + pent_at(di - nn + 1 + i) + 12 * oct_up,
				"kind": "orn", "gain": 0.28 * gs, "at": _stagger(tstep * float(i))})
		evs.append({"midi": midi, "kind": "note", "gain": 0.40 * gs,
			"at": _stagger(tstep * float(nn))})
	else:
		# 倚音 / 普通单音。倚音 = 目标音**前**加一个下行邻音，主音顺延一格。
		# ★ `rng.randf()` 无论技法开不开都照抽一次：否则"关掉技法"会顺手改掉后面
		#   （泛音那一抽、下一步的旋律）的随机流 —— 那是**静默的耦合**，A/B 就说不清了。
		var gr := rng.randf()
		if tech_on and gr < tech_grace:
			evs.append({"midi": root_midi + pent_at(di - 1) + 12 * oct_up,
				"kind": "orn", "gain": 0.22 * gs, "at": 0.0})
			evs.append({"midi": midi, "kind": "note", "gain": 0.46 * gs,
				"at": _stagger(tstep)})
		else:
			evs.append({"midi": midi, "kind": "note", "gain": 0.46 * gs, "at": 0.0})
	# 泛音：旋律**之上**一个八度的短促亮点（独立的一路）。
	# ★ `HARM_CEIL` 上限见常量注释：旋律自己已经到 A6 时再叠八度是刺耳，不是明亮。
	if rng.randf() < tech_harmonic:
		var hoc := int(_fnum(tc.get("harm_oct"), 12.0))
		if midi + hoc <= HARM_CEIL:
			evs.append({"midi": midi + hoc, "kind": "orn",
				"gain": _fnum(tc.get("harm_gain"), 0.16) * gs, "at": _stagger(tstep * 2.0)})


## **同时发声统计** —— 用户那句"听起来有点吵"的量化口径（判据 ㉘ 用它）。
##
## 口径：每个事件在 `[at, at + 该 kind 的余音长度]` 这段时间里都算"在响"，
## 在 5ms 的细网格上累加，返回峰值与均值（`grid` = 网格点数，供结论行自证量了多久）。
##
## ★★ 为什么不能数"事件条数"：琶音（依次响）与齐奏（一起响）的事件条数**完全一样**，
##   而听感天差地别 —— 用户抱怨的正是"同时"这件事。所以必须量**重叠**。
## ★ 余音长度用 `_seconds_for_kind()`（T60 口径，与合成器同一处真源）而不是渲染长度：
##   T60 之后还有 −60dB 以下的尾巴，人耳听不见；算进去只是把两边同倍放大。
##
## ★★ `flatten = true` 是**本条判据自带的阴性对照**：把每个事件的错开量归零、
##   **和弦**（`arp`）的时长一律按 `pad_seconds`（= 改造前"齐奏 + 4 秒长音"的口径）来读，
##   **而事件本身不动**。于是"改成琶音 + 缩短和弦余音到底有没有降下来"变成一个可判的数。
##   ★ 它不重实现调度（铁律 70）：事件仍然全部来自 `_schedule_step()`，变的只是"怎么读"。
##   ★★ 对照**只还原和弦**、不碰 `orn`（技法短音）：那族在改造前根本不存在，
##     把它们也按 `pad_seconds` 算会让旧口径的峰值涨到十几
##     ⇒ 任何比值界都成了一条谁都能过的假牙。
##
## ★★★ 2026-10-17：**`flatten` 不管旋律** —— `note` 仍然按**当前的** `note_seconds` 读。
##   这是有意的（它服务的是"琶音 + 和弦余音那件事降没降下来"），但必须写在这里，
##   因为本轮实测踩过它：判据 ㊱ 的面④ 曾以为"`flatten` 会把旋律也钉回 `NOTE_SECONDS_V8`"，
##   于是直接拿它当"整曲疏密的初版参照"。实际旋律那一口**两边共用** ⇒ 参照物随被测参数
##   一起动 ⇒ 那条比较几乎是一条**恒真式**（铁律 §110：参照物不许与被测物同源）。
##   ★ 证据（同一轮实测，32 小节窗口）：基线"初版口径 = **7.97**"；把 `note_seconds`
##     压回 1.6 之后，同一个"初版口径"变成 **6.49** —— 一个"初版"参照自己跟着被测参数走，
##     它就已经不叫参照了。
##   ⇒ 要量"整曲 vs 初版"，必须**连旋律一起拨回去**：㊱ 面④ 现在是先把 `note_seconds`
##     临时设成 `NOTE_SECONDS_V8`、**再**调 `flatten`，而不是指望 `flatten` 顺手办这件事。
##     只有那样参照物才是**不变**的（实测 6.49，与 `note_seconds` 无关）。
##
## ★★★ `kinds`（2026-10-16 新增）：只统计指定的音族，空数组 = 全部。
##   这一刀是为了把**和弦族单独拎出来量** —— 全曲口径下旋律的重叠会盖过
##   和弦的差别，而用户抱怨的恰恰只有和弦。判据 ㉘ 的面③ 就是 `kinds = ["arp"]`。
##   （这里**只**是"读的时候过滤"，调度器仍然只跑一次、事件仍然来自 `_schedule_step()`。）
##
## ★★★ 2026-10-16 深夜新增 `silent` / `gap`：**"留白"必须能量**（用户口令
##   「我感觉留白太多」）。`silent` = 一个声部都没有的网格点占比，`gap` = 最长的
##   连续静默秒数。★ 这两个数是从**同一个 `active[]` 数组**上顺手读出来的
##   （不另跑一遍调度、也不重算一遍时长）—— 另跑一遍就会变成"判据量的那条曲线
##   与玩家听的那条不是同一条"那种最贵的错。
##   ★ 为什么必须落在这一档：留白在**平静档**最严重（`density_calm = 0.22` 且
##     `rhythm_stride_calm = 2` ⇒ 每小节只有 4 个发声音的机会），在张力满档最不严重
##     ⇒ 只在张力满档量留白会得到一条永远绿的假牙（铁律 4：判据跑在会出问题的那档）。
func simul_stats(ax: Dictionary, bars: int, cues: Dictionary = {},
		flatten: bool = false, kinds: Array = []) -> Dictionary:
	var sd := step_seconds()
	var seg := 0.005
	var bb := maxi(bars, 1)
	var spb := _steps_per_bar()
	var total := int(float(bb * spb) * sd / seg) + 2
	var active := PackedInt32Array()
	active.resize(total)
	var max_sim := 0
	var sum := 0
	# ★★ 各音族的**事件计数**（`ev`）也一并返回：判据 ㊱ 要拿它跟"参数算出来的应有条数"
	#   对账 —— 只量"均值/静默"的话，"音符条数只有参数的一半"这种缺陷会表现为
	#   "留白偏多"，然后被当成"调一下参数就行"，根因（调度少发了）永远查不出来。
	var ev_by_kind := {}
	for k in range(1, bb * spb + 1):
		for e in _schedule_step(k, ax, str(cues.get(k, ""))):
			if not kinds.is_empty() and not kinds.has(str(e["kind"])):
				continue
			var kd := str(e["kind"])
			ev_by_kind[kd] = int(ev_by_kind.get(kd, 0)) + 1
			var atv := 0.0 if flatten else maxf(_fnum(e.get("at"), 0.0), 0.0)
			var t0 := float(k - 1) * sd + atv
			var dur := pad_seconds if (flatten and str(e["kind"]) == "arp") \
				else _seconds_for_kind(str(e["kind"]))
			var i0 := maxi(int(t0 / seg), 0)
			var i1 := mini(int((t0 + dur) / seg) + 1, total)
			for i in range(i0, i1):
				active[i] += 1
	# ★ 静默统计与峰值/均值**共用这一遍扫描**（不另跑一遍）：`gap` 要数"最长连续静默"，
	#   所以必须按 `i` 顺序走，不能事后从 `active[]` 上乱序取。
	var n_silent := 0
	var run := 0
	var max_run := 0
	for i in total:
		var v := active[i]
		max_sim = maxi(max_sim, v)
		sum += v
		if v <= 0:
			n_silent += 1
			run += 1
			max_run = maxi(max_run, run)
		else:
			run = 0
	return {"max": max_sim, "mean": float(sum) / float(maxi(total, 1)),
		"grid": total, "bars": bb, "ev": ev_by_kind,
		"silent": float(n_silent) / float(maxi(total, 1)),
		"gap": float(max_run) * seg}


## **同时起音（齐奏）统计** —— 与 `simul_stats()` 量的是**不同的物理量**，
## 两个都要有，理由见 `ONSET_EPS` 的常量注释（琶音降的不是"有几个音在响"，是"有几个音一起开始"）。
##
## 口径：把所有事件的**起音时刻**按 `eps` 宽度分桶，取**同一个桶里最多的音数**。
##   · `eps` 取 `ONSET_EPS = 30ms`：人耳对"是不是同时起音"的分辨在 20~50ms 这一带
##     （低于它听起来是一个音，高于它听起来是先后两下）—— 30ms 落在这段里。
##   · 桶是按**绝对时间**分（含 `at` 错开量），所以相邻两步（相隔 `step_seconds = 416.7ms`）
##     不会意外落进同一个桶（416.7 / 30 = 13.9 个桶）。
##   · `flatten = true` 只做一件事：`at` 一律按 0 读（= 改造前的齐奏口径）。
##     ★ 它**不**改时长 —— 时长对"起音"这个量没有任何影响，改它是掩耳盗铃。
##
## ★ 为什么不能用 `simul_stats()` 代替：3 个和弦音错开 90ms 之后**依然是 3 个音同时在响**
##   （`arp_seconds = 1.5s` 把它们全包住）⇒ 重叠峰值对琶音不敏感。用它去证明"琶音有效"，
##   会得到一条"改了也没变化、所以也没红"的恒真式。
func onset_stats(ax: Dictionary, bars: int, cues: Dictionary = {},
		flatten: bool = false, kinds: Array = []) -> Dictionary:
	var sd := step_seconds()
	var bb := maxi(bars, 1)
	var spb := _steps_per_bar()
	var bags := {}
	var n_onset := 0
	for k in range(1, bb * spb + 1):
		for e in _schedule_step(k, ax, str(cues.get(k, ""))):
			if not kinds.is_empty() and not kinds.has(str(e["kind"])):
				continue
			var atv := 0.0 if flatten else maxf(_fnum(e.get("at"), 0.0), 0.0)
			var t0 := float(k - 1) * sd + atv
			var b := int(round(t0 / ONSET_EPS))
			bags[b] = int(bags.get(b, 0)) + 1
			n_onset += 1
	var max_on := 0
	for bkey in bags.keys():
		max_on = maxi(max_on, int(bags[bkey]))
	return {"max": max_on, "onsets": n_onset, "win": ONSET_EPS,
		"buckets": bags.size(), "bars": bb}


# ===== 合成（Karplus-Strong 拨弦） =====
func midi_to_freq(m: int) -> float:
	return 440.0 * pow(2.0, (float(m) - 69.0) / 12.0)


# ===== 环路修复（缺陷 C/D）：设计参数的反解 =====
## 这一节的全部依据是一条**解析律**：环路周期
##     τ = N - N·arg(Ẽ(2π/N)) / 2π
## 其中 Ẽ 是"作用在环上的全部滤波器"（FIR 抽头、全通、DC 阻塞）在环的第 1 个 DFT 模
## θ = 2π/N 上的**复响应**。★ 相位与幅度取自**同一个复乘积** —— 不各写一份公式
## （各写一份，相位和幅度一定有一处跟不上改动）。
## 该律已在 26 个音上用**真波形**校验：最大差 0.005 采样（工作区
## `音效生成器/_proto_loop_fix.js` 第 2b 步，27 个 (f,a) 组合全过）。
## 三条推论（都实测过）：
##   · 旧引擎（两抽头平均）arg = θ/2 ⇒ τ = N - 0.5 ⇒ **音高一律偏高**（缺陷 C）；
##   · DC 阻塞带相位超前 ⇒ 再缩短 `N·arg_dc/2π` 个采样（55Hz 上 7.18 采样 ≈ 3 音分；
##     ★ 这一项**必须**用精确复响应算，不能用 `atan(dc/f)` 近似 —— 见 `_ring_len()`）；
##   · 对称三抽头 arg = θ ⇒ τ = N - 1，且**与 g0 无关** ⇒ 音高与音色解耦，可分别反解。

## 环长 N。★★ 取满足**窗口条件**的最小 N：
##         `B(N) - 1 <= D <= B(N)`，  `B(N) = τ(a=0)`（全通给到最大延迟时的周期）
##   全通只能**加**延迟，可调范围**恰好 1 个采样**（`τ(1) = B - 1`、`τ(0) = B`）——
##   所以 `D` 必须真的落进这 1 个采样的窗口，否则 `_solve_ap()` 被**静默钳位**
##   （返回 0 或 1），音高落在别处而且**不报任何错**。这是这一族里最容易踩的坑。
##
## ★★ `gd` = 环路滤波器自己的**群延迟**（采样）：三抽头 `(g0,1-2g0,g0)` 恒为 1、
##    两抽头平均 `0.5*(cur+nxt)` 为 0.5。它进的是**起点**（`ceil(D + gd - 1)`），
##    不把它算进来就会静默退化：`gd=0.5` 时按 `gd=1` 取的 N 会**过冲**
##    （440Hz：τ(1) = 50.388 > D = 50.114）⇒ 反解被钳到 `a=1`、音高 **−9.5 音分**。
##
## ★★★ 2026-10-07（四轴改造把最低音从 123.5Hz 拉到 55Hz，才把它顶出来）：
##   这一条原来用的是**模拟近似** `φ ≈ atan(dc/f)/2π`，而且**只验了窗口的一端**
##   （`while n(1-φ) < D + gd - 1`）。实测（工作区
##   `瓷砖围棋_临时输出/probe_ringlen.py`：把本文件的算式逐句同构搬进 Python 量的）：
##     · 55Hz 上 DC 阻塞的真实相位贡献 δ = **7.180** 采样，近似式给 **7.056**（差 1.7%）；
##     · N=408 的窗口是 `δ ∈ [6.091, 7.091]`，δ_real **越界 0.089**
##       ⇒ `τ(a=0) = 400.820 < D = 400.909` ⇒ `a` 被钳到 0、音高偏 **−0.383 音分**。
##   0.383 音分听不出来（听阈 5~10 音分），但它是"静默钳位"的同族，必须掐掉。
##   ⇒ 现在**用精确复响应逐点验窗口两端**（不再借近似式）。`B(N)` 与 `g0` 无关
##     （对称三抽头 arg 恒为 θ、两抽头平均恒为 θ/2）⇒ 不会与 `_g0_max()` 形成循环依赖。
##   ★ 波及面（实测）：全 MIDI 20~108 里只有 **7 个音**的 N 会变，且**全部 <= 55Hz**。
##     乐器音域（33~93）里只有最低那个音（55Hz）受影响 ⇒ 26 音扫频件与验收 wav
##     **逐字节不变**（这正是"现在修它很便宜"的唯一理由；否则要重跑一整轮锚件）。
func _ring_len(D: float, gd: float = 1.0, sr: int = 0) -> int:
	var s := sr if sr > 0 else maxi(sample_rate, 8000)
	var use3 := gd > 0.75
	var n := maxi(int(ceil(D + gd - 1.0)), 2)
	while n < 8192:
		var b := _loop_tau(s, n, 0.0, use3, true, 0.0)
		if b >= D and b - 1.0 <= D:
			break
		n += 1
	return n


## 环的复响应（在 θ₁ = 2π/N 上）。返回 [re, im, arg, mag]。
func _loop_resp(sr: int, n: int, g0: float, use_sym3: bool, ap_on: bool, a: float) -> Array:
	var th := TAU / float(n)
	var re := 0.0
	var im := 0.0
	if use_sym3:
		var t := [g0, 1.0 - 2.0 * g0, g0]
		for m in 3:
			re += float(t[m]) * cos(float(m) * th)
			im += float(t[m]) * sin(float(m) * th)
	else:
		re = 0.5 + 0.5 * cos(th)
		im = 0.5 * sin(th)
	if ap_on:
		# 一阶全通 (a + z⁻¹)/(1 + a z⁻¹)：|A| ≡ 1 ⇒ 只动相位（= 只补分数延迟）
		var nr := a + cos(th)
		var ni := -sin(th)
		var dr := 1.0 + a * cos(th)
		var di := -a * sin(th)
		var dd := dr * dr + di * di
		var qr := (nr * dr + ni * di) / dd
		var qi := (ni * dr - nr * di) / dd
		var tr := re * qr - im * qi
		im = re * qi + im * qr
		re = tr
	# 环路内的 DC 阻塞：dc_r(1 - z⁻¹)/(1 - dc_r z⁻¹)。★ 它**在环里** ⇒ 既吃相位也吃幅度，
	# 而它吃掉的幅度在高音上**比 damp 本身的余量还大**（880Hz：余量 0.00196 → 只剩 0.00108）
	# —— 原型"光滑排程"那版漏了这一项，实测越界 13/26、最多 1.8 倍。
	var dcr := exp(-TAU * clampf(dc_block_hz, 0.1, 100.0) / float(sr))
	var nr2 := dcr * (1.0 - cos(th))
	var ni2 := dcr * sin(th)
	var dr2 := 1.0 - dcr * cos(th)
	var di2 := dcr * sin(th)
	var dd2 := dr2 * dr2 + di2 * di2
	var qr2 := (nr2 * dr2 + ni2 * di2) / dd2
	var qi2 := (ni2 * dr2 - nr2 * di2) / dd2
	var tr2 := re * qr2 - im * qi2
	im = re * qi2 + im * qr2
	re = tr2
	return [re, im, atan2(im, re), sqrt(re * re + im * im)]


## 解析律：环路周期 τ（采样）。
func _loop_tau(sr: int, n: int, g0: float, use_sym3: bool, ap_on: bool, a: float) -> float:
	var r := _loop_resp(sr, n, g0, use_sym3, ap_on, a)
	return float(n) - float(n) * float(r[2]) / TAU


## 每趟衰减的目标增益：`10^(-3·trip/(sr·secs))`，trip = 环路周期（一个周期几个采样）。
func _damp_target(sr: int, D: float, secs: float) -> float:
	return pow(10.0, -3.0 * D / (float(sr) * maxf(secs, 0.05)))


## 这个音允许多大的 g0：要求 `|H(θ₁)| ≥ dampTarget`（⇒ damp ≤ 1 ⇒ 直流模态不成长）。
## ★ 为什么 damp≤1 是硬要求：`loop_comp` 的老路就是 damp>1，实测直流涨 28 倍、
##   RMS 尾段 +12.8dB（而基频 h1 正常衰减 −70dB）—— **换病不是治病**。
func _g0_max(sr: int, D: float, secs: float) -> float:
	var n := _ring_len(D, 1.0, sr)
	var dt := _damp_target(sr, D, secs)
	if float(_loop_resp(sr, n, 0.0, true, false, 0.0)[3]) < dt:
		return 0.0
	var lo := 0.0
	var hi := 0.25
	for _i in 60:
		var m := 0.5 * (lo + hi)
		if float(_loop_resp(sr, n, m, true, false, 0.0)[3]) >= dt:
			lo = m
		else:
			hi = m
	return lo


## 反解全通系数 a，使 τ = D（τ 关于 a 单调减 ⇒ 二分）。
## 返回 1.0 = 全通透明（不需要分数延迟）；返回 0.0 = 已到最大延迟。
func _solve_ap(sr: int, n: int, g0: float, use_sym3: bool, D: float) -> float:
	if _loop_tau(sr, n, g0, use_sym3, true, 1.0) >= D:
		return 1.0
	if _loop_tau(sr, n, g0, use_sym3, true, 0.0) < D:
		return 0.0
	var lo := 0.0
	var hi := 1.0
	for _i in 90:
		var mid := 0.5 * (lo + hi)
		if _loop_tau(sr, n, g0, use_sym3, true, mid) > D:
			lo = mid
		else:
			hi = mid
	return 0.5 * (lo + hi)


## 生成一段拨弦 PCM（float，峰值约 ±1）。
## 原理：延迟线长度 N = 采样率/频率（= 一个周期），先用**锯齿⊕噪声**灌满延迟线当激励，
## 之后**每采样**用 `y[i] = damp * 0.5 * (y[i] + y[i+1])` 回灌 ⇒ 高频先衰减，听感就是"铮"。
## `damp` 由 T60 反解（★ `trip` 必须进指数）：`10^(-3·trip/(sr·t60))`，`trip = N + 0.5`；
##   旧式 `0.001^(1/(sr·t60))` 漏了 trip ⇒ 实测 T60 比请求长 **9 倍**（见本函数内的注）。
func pluck_pcm(freq: float, seconds: float, bright: float) -> PackedFloat32Array:
	var sr := maxi(sample_rate, 8000)
	var n := maxi(int(seconds * float(sr)), 8)
	var out := PackedFloat32Array()
	out.resize(n)
	var nn := maxi(int(round(float(sr) / maxf(freq, 20.0))), 2)     # 延迟线长度
	# ★★ 修复后的环长 / 三抽头 g0 / 全通系数（两个开关都关时下面这些都不参与运算，
	#    旧路径逐字保留 ⇒ **逐位相同**）。
	var D := float(sr) / maxf(freq, 20.0)                         # 目标环路周期（采样）
	# ★ 环路滤波器的群延迟**必须**与 `_ring_len()` 口径一致（见那边的注）：滤波器**形状**
	#   由 `loop_loss_fix` 独家决定 ⇒ 三抽头 gd=1、两抽头平均 gd=0.5。
	#   写错就会让全通反解被静默钳位（440Hz 上 −9.5 音分，且不报错）。
	var gd := 1.0 if loop_loss_fix else 0.5
	var g0 := 0.0
	var ap_on := false
	var ap_a := 0.0
	var mag := 1.0
	if loop_pitch_fix or loop_loss_fix:
		nn = _ring_len(D, gd, sr)
	if loop_loss_fix:
		# g0 = 该音精确预算 × 0.9（留裕度保证 damp<1），再受音色上限约束。
		# ★ 用**逐音**预算而不是全局常数：全局常数会把整条滤波器按最紧的音一起压平
		#   （实测那样 440Hz 的谐波倾角只剩旧引擎的 0.61 倍）。
		g0 = minf(loop_damp_max, _g0_max(sr, D, seconds) * 0.9)
	if loop_pitch_fix:
		ap_a = _solve_ap(sr, nn, g0, loop_loss_fix, D)
		ap_on = true
	if loop_loss_fix:
		mag = maxf(float(_loop_resp(sr, nn, g0, true, ap_on, ap_a)[3]), 1e-6)
	var dl := PackedFloat32Array()
	dl.resize(nn)
	# ★ 固定种子：自检要能"同输入同输出"（否则判据 ③④⑤ 全成随机量）
	var rng := RandomNumberGenerator.new()
	rng.seed = 20261005
	# ★★ 激励 = 确定性锯齿 ⊕ 白噪声（比例由 `excit_noise` 调）。
	#   为什么必须掺确定性分量：白噪声激励下**每根谐波的幅度是随机抽签**，会被抽到≈0。
	#   实测 A4：1x / 0.73x / **0.01x** / 0.22x / 0.04x（第 3 谐波几乎不存在，真弦应约 0.33x），
	#   第 6/7/9 谐波也≈0 ⇒ 谱是"带随机零点的梳状" ⇒ 听感空、细、"像绷紧的琴弦"。
	#   ★ 噪声仍**每轮抽一次**（顺序与首版完全一致）⇒ `excit_noise = 1.0` 时
	#     `dl[i]` 与首版**逐位相同**，音色一字不变（有 md5 逐字节核对作证）。
	var mix_noise := clampf(excit_noise, 0.0, 1.0)
	for i in nn:
		var saw := 2.0 * ((float(i) + 0.5) / float(nn)) - 1.0   # 零均值、一个周期
		var nz := rng.randf_range(-1.0, 1.0)
		dl[i] = saw * (1.0 - mix_noise) + nz * mix_noise
	# 亮度：对激励做一阶低通（bright=1 ⇒ 不动；越小越闷）
	var b := clampf(bright, 0.0, 1.0)
	if b < 1.0:
		var a := clampf(b, 0.0, 1.0)          # 直通比例
		var prev := dl[0]
		for i in nn:
			prev = prev + a * (dl[i] - prev)
			dl[i] = prev
	# ★★ 弦**没有净位移** ⇒ 激励必须零均值。
	#    （只扣激励均值**不够**，见下面那条直流阻塞；但它是必要的第一步。）
	var ex_mean := 0.0
	for i in nn:
		ex_mean += dl[i]
	ex_mean /= float(nn)
	for i in nn:
		dl[i] -= ex_mean
	# ★★ **每趟**衰减 = 10^(-3·trip/(sr·t60))：`trip` 必须进指数。
	#    首版写成 `0.001^(1/(sr·t60))`（漏了 trip）⇒ 实测 T60 = 7.0~7.6s（请求 0.8s，超 9 倍）
	#    ⇒ 每拍（0.417s）之间叠十几个还在响的音、整段糊成一片。这是判据 ⑯ 逼出来的。
	# ★★ `trip` = **环路周期**。旧代码写 `nn + 0.5` 是**符号写反**（真实是 nn − 0.5：
	#    就地顺序更新 + 两抽头平均的相位是 +θ/2）—— 缺陷 C 的记账口径错就在这里。
	#    修好后 trip = D = sr/f，与 `_solve_ap()` 反解出来的周期一致。
	var trip := (D if loop_loss_fix else float(nn) + 0.5)
	var damp := pow(10.0, -3.0 * trip / (float(sr) * maxf(seconds, 0.05)))
	if loop_loss_fix:
		# ★★ 反解 damp：每趟的**总**增益 = damp × |H(θ₁)| ⇒ 令它**恰好** = dampTarget
		#    ⇒ 基频 T60 = seconds **按构造成立**（不靠拟合）。
		#    ★ 不能走"把 |H| 的损耗补偿进 damp、不管 |H| 的形状"那条路：那样 damp 在高音上
		#      会 >1 ⇒ 直流模态成长（实测 RMS 尾段 +12.8dB、直流 ×28）。
		#      把 |H(θ₁)| 抬到接近 1（三抽头）才是"用形状换时长"的正路。
		damp /= mag
	# ★★ 环路内**直流阻塞**：环形延迟线的 k=0 模态（整根弦平移）物理上不存在
	#    （弦两端固定），而且它的环路增益最高 —— 不掐掉它，直流必然盖过基频。
	#    实测：不掐时 880Hz 音的**尾段 99.98% 是直流**、0-40Hz 占全部能量 99.95%。
	var dc_r := exp(-TAU * clampf(dc_block_hz, 0.1, 100.0) / float(sr))
	var idx := 0
	var dc_lp := 0.0
	# 对称三抽头 `(g0, 1-2g0, g0)`：对称 ⇒ 群延迟**恒为 1 且与 g0 无关** ⇒ 不动音高；
	# `|H| ≈ 1-g0θ²` 与两抽头的 `1-θ²/8` 同族 ⇒ 谐波衰减的**形状**不变、只缩到预算允许的量级。
	# ★★ 但**只开 `loop_pitch_fix` 时绝不能走 sym3**：那时 g0 = 0 ⇒ sym3 退化成 `[0,1,0]`
	#    **单抽头**，群延迟 1 采样 —— 比旧 `avg2` 的 0.5 多出半拍，440Hz 上就是 +7.8 音分；
	#    更要命的是**总延迟已经超过 D** ⇒ `_solve_ap` 反解不到（`a` 被钳到 0、音高找不回来）。
	#    这正是原型里 `pitchonly` 变体（= 阴性对照 ⑤）用的 **avg2 + 全通**。
	#    ⇒ 滤波器**形状**由 `loop_loss_fix` 独家决定，`loop_pitch_fix` 只补分数延迟：
	#      两个开关各管一个轴，既有"一次只动一个轴"的 A/B 可做，
	#      也让"只修音高"那件能逐字节对上原型的 `pitchonly`（跨实现对拍）。
	var use_sym3 := loop_loss_fix
	var ft0 := g0
	var ft1 := 1.0 - 2.0 * g0
	var ft2 := g0
	var ap_xp := 0.0                       # 全通状态：上一拍的输入 / 输出
	var ap_yp := 0.0
	for i in n:
		var cur := dl[idx]
		var nxt := dl[(idx + 1) % nn]
		out[i] = cur
		var raw := 0.0
		if loop_pitch_fix or loop_loss_fix:
			var x := 0.0
			if use_sym3:
				x = ft0 * cur + ft1 * nxt + ft2 * dl[(idx + 2) % nn]
			else:
				x = 0.5 * (cur + nxt)      # ★ 旧滤波器原样 ⇒ 只修音高时音色不动
			if ap_on:
				var y := ap_a * x + ap_xp - ap_a * ap_yp
				ap_xp = x
				ap_yp = y
				x = y
			raw = damp * x
		else:
			raw = damp * 0.5 * (cur + nxt)
		dc_lp += (1.0 - dc_r) * (raw - dc_lp)
		dl[idx] = raw - dc_lp
		idx = (idx + 1) % nn
	# 归一化到 ±1（否则不同音高的响度差很多 —— 低音延迟线长、噪声平均后更响）
	var peak := 0.0
	for i in n:
		peak = maxf(peak, absf(out[i]))
	if peak > 0.0001:
		var inv := 1.0 / peak
		for i in n:
			out[i] = out[i] * inv
	return out


## 事件种类 → 余音长度 / 激励亮度。★★ **唯一真源**：在线取流（`wav_for()`）与离线渲染
## （`render_offline()`）都必须走它。此前那两处各写了一份 `if kind == "pad"` ——
## 加第三种 kind（2026-10-16 的 `tick`）时"只改一处"是**必然**发生的，而症状是
## "在线听是短促的读秒声、离线验收 wav 里却是长音"，两边都不报错。
##
## ★★ 2026-10-16 五族齐备（用户口令「减少同时弹奏的和弦」）：
##   `arp` = 琶音（和弦音：**短于** note，否则相邻小节的和弦会叠起来）
##   `orn` = 装饰短音（刮奏/摇指/倚音/泛音共用，0.6s：必须远短于 arp，
##           因为刮奏是 7~8 个音在 0.4 秒里跑完）
##   ⚠️ 加族时**必须**同时加进 `_timbre_fp()`：不进指纹 ⇒ 运行期改它不失效缓存
##      ⇒ "调了参数却没变化"那种静默缺陷（同 `_wav_cache_guard` 的注释）。
##
## ★★★ 2026-10-16 深夜：`arp` 这一族改成**派生量** `minf(arp_seconds, _arp_fit_seconds())`。
##   为什么允许它与其他四族不同：另外四族是**音色**（一根弦衰多快，与曲子快慢无关），
##   而 `arp` 还背着一份**结构契约** —— 和弦族不许跨小节。契约里含"小节有多长"，
##   小节长随 BPM 变，所以这一族只能由当前速度算出来，不能是一个固定秒数。
##   ★ 这个 `minf` 的**单一读点就在这里**：调度、在线取流、离线渲染、判据四条路都走它
##     ⇒ "在线听的和弦比验收 wav 里短"这类静默分家不可能发生（守卫 S68/S71 钉这一点）。
func _seconds_for_kind(kind: String) -> float:
	match kind:
		"pad":
			return pad_seconds
		"tick":
			return tick_seconds
		"arp":
			return minf(arp_seconds, _arp_fit_seconds())
		"orn":
			return orn_seconds
		_:
			return note_seconds


func _bright_for_kind(kind: String) -> float:
	if kind == "tick":
		return tick_brightness
	if kind == "orn":
		return orn_brightness
	return brightness


func _timbre_fp() -> String:
	# ★ `excit_noise` 必须进指纹：不进的话运行期改它**不失效缓存** ⇒
	#   "调了参数却没变化"是静默的（同 _wav_cache_guard 那几句注释）。
	# ★★ 环路修复开关与 g0 上限同理 —— 它们改的是**每一个音**，不进指纹就是
	#   "拧了开关没反应"那种静默缺陷。
	# ★ 读秒声的两个参数同理（它们只影响 `tick` 这一族，但取值就是"每一个 tick 音"）。
	# ★★ 2026-10-16 新增三族同理：`arp` / `orn` 的时长与亮度不进指纹 ⇒ 运行期把它们
	#   改短改亮**不会有任何变化**（缓存里还是旧值）—— "拧了旋钮没反应"是最典型的静默缺陷。
	return "%d|%.3f|%.2f|%.2f|%d%d|%.3f|%.3f|%.2f|%.3f|%.3f|%.2f" % [sample_rate,
		note_seconds, brightness,
		excit_noise, 1 if loop_pitch_fix else 0, 1 if loop_loss_fix else 0, loop_damp_max,
		tick_seconds, tick_brightness, arp_seconds, orn_seconds, orn_brightness]


func _wav_cache_guard() -> void:
	# 音色参数变了 ⇒ 旧缓存全废（否则"调了参数却没变化"是静默的）
	var fp := _timbre_fp()
	if fp != _cache_fp:
		_wav_cache.clear()
		_cache_fp = fp
	# 简单上界：长时间运行不会无限长
	if _wav_cache.size() > 128:
		_wav_cache.clear()


## ★★ 单声部音源 —— **在线与离线唯一**的合成入口（守卫 S68 钉的就是这一点）。
##
## `at` = 这个音在**本步之内**的起音偏移（秒）。实现方式是**前置静音**（把 PCM 前面补
## `at` 秒的 0），于是"琶音错开 / 刮奏 / 摇指"这件事在两条路上**逐采样等价**。
##
## ★★ 为什么不能"在线用定时器、离线用采样偏移"：那两条路会**静默分家** ——
##   在线听是琶音、验收 wav 里却是齐奏（或反过来），而两边都不报任何错，
##   判据 ⑬⑭ 只看长度与非静音也照样绿 ⇒ 那时"人耳验收件"就再也不代表玩家听到的东西了。
##   把偏移折算成样本、两条路共用这一份 PCM，等于让"同源"成为**构造成立**的事实。
##
## ★ `at <= 0` ⇒ **原样返回** `pluck_pcm()` 的那个数组（逐位相同）：
##   没有特殊时刻、`arp_step = 0`、旧调用点 —— 全部一个字节都不动。
## `at`（错开起音量，秒）折算成**前置静音样本数** —— **单真源**（守卫 S106 钉着）。
## ★★ 为什么必须是单真源：这个数有**两个**消费者，而且它们必须永远一致 ——
##   ① `voice_pcm()` 拿它铺前置静音（真正的音响效果）；
##   ② `wav_for()` 拿它进**缓存键**（错开量不同的音不能共用一份流；不带它 ⇒ 琶音静默退回齐奏）。
##   两份各写一遍的话，一处改了另一处没改是必然的，而且**两边都不报错**：
##   · 只改 ① ⇒ 缓存键把两个错开量不同的音判成同一个 ⇒ 后一个拿到前一个的流（齐奏复活）；
##   · 只改 ② ⇒ 缓存里全是不带静音的流，琶音听起来没发生。
## ★ 取整用 `round` 而不是 `int`：`at` 来自 `_arp_gap() × i`（浮点乘），
##   `int()` 会把 0.0899999 截成 0 ⇒ 两个和弦音撞进同一格。
## ★ 采样率下限 8000 与 `_pcm_to_wav()` / `_ring_len()` 同一口径。
func _at_pad(at: float) -> int:
	return int(round(maxf(at, 0.0) * float(maxi(sample_rate, 8000))))


func voice_pcm(midi: int, kind: String, at: float = 0.0) -> PackedFloat32Array:
	var body := pluck_pcm(midi_to_freq(midi), _seconds_for_kind(kind), _bright_for_kind(kind))
	var pad := _at_pad(at)
	if pad <= 0:
		return body
	var out := PackedFloat32Array()
	out.resize(pad + body.size())
	for i in body.size():
		out[pad + i] = body[i]
	return out


## 取（并缓存）某个音的 AudioStreamWAV。`kind` 决定时长/亮度（走 `_seconds_for_kind()` /
## `_bright_for_kind()`），`at` 走 `voice_pcm()` 折成前置静音。
## ★ 缓存键必须带上**折算后的静音样本数**（不能只带 `at` 的浮点数：那样 0.0901 与 0.0899
##   会各占一格而拿到同一份流，白占内存；也不能不带：不带就等于"错开量不同的音共用一份流"
##   ⇒ 琶音会静默退回齐奏）。
func wav_for(midi: int, kind: String, at: float = 0.0) -> AudioStreamWAV:
	_wav_cache_guard()
	# ★ 缓存键里的 `pad` 与 `voice_pcm()` 里铺静音用的是**同一个数**（`_at_pad()`，守卫 S106）。
	var pad := _at_pad(at)
	var key := "%d|%s|%d|%s" % [midi, kind, pad, _cache_fp]
	if _wav_cache.has(key):
		return _wav_cache[key]
	var w := _pcm_to_wav(voice_pcm(midi, kind, at))
	_wav_cache[key] = w
	return w


func _pcm_to_wav(pcm: PackedFloat32Array) -> AudioStreamWAV:
	var bytes := PackedByteArray()
	bytes.resize(pcm.size() * 2)
	for i in pcm.size():
		bytes.encode_s16(i * 2, int(clampf(pcm[i], -1.0, 1.0) * 32767.0))
	var w := AudioStreamWAV.new()
	w.format = AudioStreamWAV.FORMAT_16_BITS
	w.mix_rate = maxi(sample_rate, 8000)
	w.stereo = false
	w.data = bytes
	w.loop_mode = AudioStreamWAV.LOOP_DISABLED
	return w


func _is_headless() -> bool:
	return DisplayServer.get_name() == "headless"


func _play_event(e: Dictionary, accent: bool) -> void:
	if muted or _is_headless():
		if _is_headless() and not _no_audio_warned:
			_no_audio_warned = true
			print("[Music] headless：不实际发声（只跑调度；判据靠数值不靠听）")
		return
	if _pool.is_empty():
		return
	var p := _pool[_pool_i % _pool.size()]
	_pool_i += 1
	p.stream = wav_for(int(e["midi"]), str(e["kind"]), float(e.get("at", 0.0)))
	var db := linear_to_db(maxf(bgm_volume, 0.0001)) + linear_to_db(clampf(float(e["gain"]), 0.01, 1.0))
	p.volume_db = db + (3.0 if accent else 0.0)
	p.play()


# ===== 离线渲染（供人耳验收 + 供工作区 Python 做独立频谱验证） =====
## 用**同一份** `_schedule_step()` 与**同一份** `voice_pcm()` 把 N 秒渲染成 PCM。
## ★ 这不是"另写一个合成器"：调度与合成都是调同一批函数，所以验证的是**引擎真实输出**。
## ★ 无副作用：调度按**显式传入的 k** 播种（不用 `_step_idx`），渲染完不改动本节点任何状态。
## `st` 非空且带局势层 ⇒ 走四轴；否则用 `tension` 走退化档（旧口径，逐字节不变）。
## `cues` = 「步号 → 时刻名」的**注入表**（只给验收件与自检用）：它让"吃子时会响什么"
##   不必真等一次吃子才听得到。默认空 ⇒ 与改造前逐字节相同。
func render_offline(seconds: float, tension: float, st: Dictionary = {},
		cues: Dictionary = {}) -> PackedFloat32Array:
	var sr := maxi(sample_rate, 8000)
	var n := maxi(int(seconds * float(sr)), 8)
	var mix := PackedFloat32Array()
	mix.resize(n)
	var sd := step_seconds()
	var ax := axes_from(tension, st)
	var steps := int(seconds / sd) + 1
	for k in range(1, steps + 1):
		var start := int(float(k - 1) * sd * float(sr))
		if start >= n:
			break
		for e in _schedule_step(k, ax, str(cues.get(k, ""))):
			var kind_s := str(e["kind"])
			# ★ 时长的真源在 `voice_pcm()` → `_seconds_for_kind()`（与在线 `wav_for()` 同一处）
			#   —— 离线这一侧**不重写** `if kind == "pad"`：那正是上一版的分叉点。
			# ★ `at` 也在 `voice_pcm()` 里折成前置静音 ⇒ 两条路的"错开起音"逐采样等价。
			var voice := voice_pcm(int(e["midi"]), kind_s, float(e.get("at", 0.0)))
			var g := clampf(float(e["gain"]), 0.0, 1.0) * bgm_volume
			for i in voice.size():
				var j := start + i
				if j >= n:
					break
				mix[j] += voice[i] * g
	return mix


## 特殊时刻的**验收件**：把 `CUE_IDS` 里每个乐句各渲染一段，首尾相接成一个 wav。
##
## ★★ 为什么必须有它：乐句好不好听**只能**由耳朵裁决，而在游戏里要听到"吃子那一下"
##   得真等到一次提子（还要正好是那一步）—— 六个时刻一次听全，才有可比较的验收件。
##   同 `--musicdump` 的理由：把"没验"变成"能验"。
## ★ 每段都是**正常的小节床 + 一句乐句**（乐句落在第 2 个小节头，`cue_step`），
##   所以听到的是它真实的上下文，而不是一句孤立的音型。
## ★ 打印时间轴是**判据的一部分**：不听时间轴就无法知道哪一段对应哪个时刻
##   （而"听不出来是哪一段"会让整个验收件白做）。
func render_cue_demo(per_seconds: float = 4.5, gap_seconds: float = 0.5) -> PackedFloat32Array:
	var sr := maxi(sample_rate, 8000)
	var out := PackedFloat32Array()
	var gap := maxi(int(gap_seconds * float(sr)), 0)
	var cue_step := maxi(_steps_per_bar(), 1)          # 第 2 个小节头
	var t0 := float(cue_step - 1) * step_seconds()
	print("[Music] 特殊时刻验收件：每段 %.2fs，乐句落在段内第 %.2fs（第 %d 步）" % [
		per_seconds, t0, cue_step])
	for c in CUE_IDS:
		print("        %-12s @ 全曲 %.2fs" % [str(c), float(out.size()) / float(sr)])
		out.append_array(render_offline(per_seconds, 0.0, {}, {cue_step: str(c)}))
		for _i in gap:
			out.append(0.0)
	print("        合计 %.2fs（%d 段 + 段间 %.2fs 静音）" % [
		float(out.size()) / float(sr), CUE_IDS.size(), gap_seconds])
	return out


## 写 16-bit 单声道 wav（手写 RIFF 头：不依赖任何版本相关的保存 API）。
func save_wav(path: String, pcm: PackedFloat32Array) -> bool:
	var f := FileAccess.open(path, FileAccess.WRITE)
	if f == null:
		push_warning("[Music] 打不开 wav 输出路径：%s" % path)
		return false
	var sr := maxi(sample_rate, 8000)
	var data_bytes := pcm.size() * 2
	f.store_buffer("RIFF".to_ascii_buffer())
	f.store_32(36 + data_bytes)
	f.store_buffer("WAVEfmt ".to_ascii_buffer())
	f.store_32(16)
	f.store_16(1)                # PCM
	f.store_16(1)                # 单声道
	f.store_32(sr)
	f.store_32(sr * 2)           # 字节率
	f.store_16(2)                # 块对齐
	f.store_16(16)               # 位深
	f.store_buffer("data".to_ascii_buffer())
	f.store_32(data_bytes)
	for i in pcm.size():
		f.store_16(int(clampf(pcm[i], -1.0, 1.0) * 32767.0))
	f.close()
	return true


